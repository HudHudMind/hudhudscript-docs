// ES - Chemistry Module

// Molar Mass
función molarMass(atoms, atomicWeight) {
    retornar atoms * atomicWeight;
}

// Concentration = Moles / Volume
función concentration(moles, volume) {
    retornar moles / volume;
}

// pH calculation
función pH(hydrogenConcentration) {
    retornar 14 - hydrogenConcentration;
}

// Density = Mass / Volume
función density(mass, volume) {
    retornar mass / volume;
}

// Dilution: C1*V1 = C2*V2
función dilution(c1, v1, v2) {
    retornar (c1 * v1) / v2;
}
