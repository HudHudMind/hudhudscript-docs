// Русский - Концепция Возврата
// return

функция квадрат(x) {
    вернуть x * x;
}

функция куб(x) {
    вернуть x * x * x;
}

печать("=== Math Functions ===");
печать("квадрат(5): " + квадрат(5));
печать("куб(3): " + куб(3));

функция абсолютное(x) {
    если (x < 0) {
        вернуть -x;
    }
    вернуть x;
}

печать("\n=== Absolute ===");
печать("абсолютное(-7): " + абсолютное(-7));
печать("абсолютное(3): " + абсолютное(3));

функция создай_точку(x, y) {
    вернуть { x: x, y: y };
}

пусть p = создай_точку(10, 20);
печать("\n=== Point ===");
печать("Point: (" + p.x + ", " + p.y + ")");

функция факториал(n) {
    если (n <= 1) {
        вернуть 1;
    }
    вернуть n * факториал(n - 1);
}

печать("\n=== Factorial ===");
печать("5! = " + факториал(5));
печать("10! = " + факториал(10));
