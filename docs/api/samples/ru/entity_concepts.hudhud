// Русский - Концепции сущностей

пусть пользователь = {
    ид: 1,
    имя: "Алиса",
    почта: "alisa@example.com",
    роль: "разработчик"
};

пусть продукт = {
    ид: 101,
    имя: "Среда разработки ХудХудСкрипт",
    версия: "2.0",
    цена: 49
};

пусть заказ = {
    ид: 1001,
    ид_пользователя: 1,
    ид_продукта: 101,
    количество: 2,
    статус: "подтверждён"
};

функция информация_сущности(сущность) {
    вернуть "Сущность #" + сущность.ид + ": " + сущность.имя;
}

функция рассчитать_итого(заказ, цена) {
    вернуть заказ.количество * цена;
}

печать("=== Система сущностей ===");
печать(информация_сущности(пользователь));
печать(информация_сущности(продукт));
пусть итого = рассчитать_итого(заказ, продукт.цена);
печать("Заказ #" + заказ.ид + " итого: " + итого);
печать("Статус: " + заказ.статус);
