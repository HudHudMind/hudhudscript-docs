// Использование пакетов - Система пакетов ХудХудСкрипт
// Система управления пакетами: создание, установка, публикация и использование

// ============================================================
// 1. ИСПОЛЬЗОВАНИЕ ПАКЕТОВ
// ============================================================

// Использование внешнего пакета
использовать "алгебра";
использовать "физика";

// Импорт конкретных модулей из пакета
использовать "алгебра/матрица";
использовать "алгебра/вектор";
использовать "физика/движение";

печать("============================================================");
печать("Демо системы пакетов ХудХудСкрипт");
печать("============================================================\n");

// ============================================================
// 2. ИСПОЛЬЗОВАНИЕ ФУНКЦИЙ ПАКЕТА
// ============================================================

печать("Использование пакета алгебры:");
печать("─────────────────────────────────────────────────────────\n");

// Создание матрицы
пусть матрица1 = Матрица([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

пусть матрица2 = Матрица([
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]);

печать("Матрица 1:");
матрица1.показать();

печать("\nМатрица 2:");
матрица2.показать();

// Сложение матриц
пусть сумма = матрица1.сложить(матрица2);
печать("\nСложение матриц:");
сумма.показать();

// Операции с векторами
пусть вектор1 = Вектор([1, 2, 3]);
пусть вектор2 = Вектор([4, 5, 6]);

печать("\n\nОперации с векторами:");
печать("─────────────────────────────────────────────────────────\n");

печать("Вектор 1: " + вектор1.строка());
печать("Вектор 2: " + вектор2.строка());

пусть скалярное = вектор1.скалярное(вектор2);
печать("Скалярное произведение: " + скалярное);

пусть векторное = вектор1.векторное(вектор2);
печать("Векторное произведение: " + векторное.строка());

// ============================================================
// 3. ИСПОЛЬЗОВАНИЕ ПАКЕТА ФИЗИКИ
// ============================================================

печать("\n\nИспользование пакета физики:");
печать("─────────────────────────────────────────────────────────\n");

// Расчёты движения
пусть начальная_скорость = 0;     // м/с
пусть ускорение = 9.8;            // м/с² (гравитация)
пусть время = 5;                   // секунд

пусть конечная_скорость = Движение.рассчитать_скорость(начальная_скорость, ускорение, время);
пусть расстояние = Движение.рассчитать_расстояние(начальная_скорость, ускорение, время);

печать("Начальная скорость: " + начальная_скорость + " м/с");
печать("Ускорение: " + ускорение + " м/с²");
печать("Время: " + время + " с");
печать("─────────────────────────────────────────────────────────");
печать("Конечная скорость: " + конечная_скорость + " м/с");
печать("Пройденное расстояние: " + расстояние + " м");

// ============================================================
// 4. СОЗДАНИЕ ПАКЕТОВ
// ============================================================

печать("\n\nСоздание пакетов:");
печать("─────────────────────────────────────────────────────────\n");

печать("1. Создайте файл hudhud.toml:");
печать("   [пакет]");
печать("   имя = 'математические-утилиты'");
печать("   версия = '1.0.0'");
печать("   описание = 'Вспомогательные математические функции'");

печать("\n2. Добавьте зависимости:");
печать("   [зависимости]");
печать("   алгебра = '^2.0.0'");
печать("   физика = '^1.5.0'");

// ============================================================
// 5. КОМАНДЫ УПРАВЛЕНИЯ ПАКЕТАМИ
// ============================================================

печать("\n\nКоманды управления пакетами:");
печать("─────────────────────────────────────────────────────────\n");

печать("Установка пакета:");
печать("  hudhudscript install алгебра");
печать("  hudhudscript install физика@1.5.0");

печать("\nОбновление пакета:");
печать("  hudhudscript update алгебра");
печать("  hudhudscript update --all");

печать("\nУдаление пакета:");
печать("  hudhudscript remove алгебра");

печать("\nСписок установленных пакетов:");
печать("  hudhudscript list");

печать("\nПоиск пакета:");
печать("  hudhudscript search математика");

печать("\nИнформация о пакете:");
печать("  hudhudscript info алгебра");

// ============================================================
// 6. ЗАВИСИМОСТИ ПАКЕТОВ
// ============================================================

печать("\n\nЗависимости пакетов:");
печать("─────────────────────────────────────────────────────────\n");

печать("Указание версии:");
печать("  'алгебра' = '^2.0.0'    # 2.x.x");
печать("  'физика' = '~1.5.0'    # 1.5.x");
печать("  'химия' = '1.2.3'     # Точная версия");

печать("\nИз репозитория Гит:");
печать("  'моя-библиотека' = { git = 'https://github.com/user/my-lib' }");

печать("\nИз локального пути:");
печать("  'локальная-библиотека' = { path = '../локальная-библиотека' }");

// ============================================================
// 7. БЕЗОПАСНОСТЬ ПАКЕТОВ
// ============================================================

печать("\n\nБезопасность пакетов:");
печать("─────────────────────────────────────────────────────────\n");

печать("Проверка безопасности:");
печать("  hudhudscript audit");

печать("\nПроверка контрольной суммы:");
печать("  hudhudscript verify алгебра");

печать("\n============================================================");
печать("Демо системы пакетов завершено!");
печать("Пишите модульный и переиспользуемый код с ХудХудСкрипт");
печать("============================================================");
