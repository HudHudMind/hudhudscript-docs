// Русский - Control Flow
пусть счётчик = 0;
пусть максимум = 5;

// Loop
пока (счётчик < максимум) {
    счётчик = счётчик + 1;
}

// Conditional
пусть оценка = 85;

если (оценка >= 90) {
    оценка;
} иначе {
    если (оценка >= 80) {
        оценка;
    } иначе {
        оценка;
    }
}

счётчик;
