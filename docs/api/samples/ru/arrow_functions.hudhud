// Русский - Стрелочные функции
// Современный, краткий синтаксис для функций

// Стрелочная функция - короткий синтаксис
пусть сложить = (а, б) => а + б;
пусть умножить = (х, у) => х * у;

печать(сложить(5, 3));      // 8
печать(умножить(4, 7)); // 28

// Стрелочная функция с блоком
пусть вычислить = (а, б) => {
    пусть сумма = а + б;
    пусть произведение = а * б;
    вернуть сумма + произведение;
};

пусть результат = вычислить(5, 3);
печать(результат);  // 23 (8 + 15)

// Один параметр (скобки не нужны)
пусть квадрат = х => х * х;
печать(квадрат(6));  // 36

// Без параметров
пусть приветствие = () => "Привет!";
печать(приветствие());  // Привет!
