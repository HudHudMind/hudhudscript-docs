// Српски - Концепти ентитета

нека корисник = {
    ид: 1,
    име: "Ана",
    имејл: "ana@primer.com",
    улога: "програмер"
};

нека производ = {
    ид: 101,
    име: "ХудХудСкрипт ИДЕ",
    верзија: "2.0",
    цена: 49
};

нека наруџбина = {
    ид: 1001,
    ид_корисника: 1,
    ид_производа: 101,
    количина: 2,
    статус: "потврђено"
};

функција инфо_ентитета(ентитет) {
    vrati "Ентитет #" + ентитет.ид + ": " + ентитет.име;
}

функција израчунај_укупно(наруџбина, цена) {
    vrati наруџбина.количина * цена;
}

ispiši("=== Систем ентитета ===");
ispiši(инфо_ентитета(корисник));
ispiši(инфо_ентитета(производ));
нека укупно = израчунај_укупно(наруџбина, производ.цена);
ispiši("Наруџбина #" + наруџбина.ид + " укупно: " + укупно);
ispiši("Статус: " + наруџбина.статус);
