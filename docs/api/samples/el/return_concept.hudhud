// Ελληνικά - Έννοια Επιστροφής
// return

συνάρτηση τετράγωνο(x) {
    επέστρεψε x * x;
}

συνάρτηση κύβος(x) {
    επέστρεψε x * x * x;
}

εκτύπωσε("=== Math Functions ===");
εκτύπωσε("τετράγωνο(5): " + τετράγωνο(5));
εκτύπωσε("κύβος(3): " + κύβος(3));

συνάρτηση απόλυτο(x) {
    αν (x < 0) {
        επέστρεψε -x;
    }
    επέστρεψε x;
}

εκτύπωσε("\n=== Absolute ===");
εκτύπωσε("απόλυτο(-7): " + απόλυτο(-7));
εκτύπωσε("απόλυτο(3): " + απόλυτο(3));

συνάρτηση δημιούργησε_σημείο(x, y) {
    επέστρεψε { x: x, y: y };
}

έστω p = δημιούργησε_σημείο(10, 20);
εκτύπωσε("\n=== Point ===");
εκτύπωσε("Point: (" + p.x + ", " + p.y + ")");

συνάρτηση παραγοντικό(n) {
    αν (n <= 1) {
        επέστρεψε 1;
    }
    επέστρεψε n * παραγοντικό(n - 1);
}

εκτύπωσε("\n=== Factorial ===");
εκτύπωσε("5! = " + παραγοντικό(5));
εκτύπωσε("10! = " + παραγοντικό(10));
