// Ελληνικά - Διαχείριση σφαλμάτων
// try/catch/finally, throw

// Basic try/catch
συνάρτηση διαίρεσε(a, b) {
    αν (b == 0) {
        ρίξε "Σφάλμα διαίρεσης με μηδέν";
    }
    επέστρεψε a / b;
}

δοκίμασε {
    έστω result = διαίρεσε(10, 2);
    εκτύπωσε("10 / 2 = " + result);
} πιάσε (error) {
    εκτύπωσε("Σφάλμα: " + error);
}

// Try/catch/finally
εκτύπωσε("
=== Επεξεργασία αρχείου ===");

συνάρτηση επεξεργασία_αρχείου(filename) {
    αν (filename == "") {
        ρίξε "Σφάλμα κενού ονόματος αρχείου";
    }
    εκτύπωσε("Επεξεργασία: " + filename);
    επέστρεψε "Δεδομένα από " + filename;
}

δοκίμασε {
    έστω data = επεξεργασία_αρχείου("report.txt");
    εκτύπωσε("Αποτέλεσμα: " + data);
} πιάσε (error) {
    εκτύπωσε("Σφάλμα: " + error);
} τελικά {
    εκτύπωσε("Καθαρισμός ολοκληρώθηκε");
}

// Nested error handling
εκτύπωσε("
=== Ένθετη διαχείριση σφαλμάτων ===");

δοκίμασε {
    εκτύπωσε("Εξωτερικό μπλοκ δοκίμασε");
    δοκίμασε {
        ρίξε "Εσωτερικό σφάλμα";
    } πιάσε (inner_err) {
        εκτύπωσε("Πιάστηκε εσωτερικό: " + inner_err);
        ρίξε "Επαναριπτόμενο σφάλμα";
    }
} πιάσε (outer_err) {
    εκτύπωσε("Πιάστηκε εξωτερικό: " + outer_err);
} τελικά {
    εκτύπωσε("Όλα ολοκληρώθηκαν");
}
