// Ελληνικά - Έννοιες Οντοτήτων

έστω χρήστης = {
    id: 1,
    όνομα: "Αλίκη",
    email: "aliki@παράδειγμα.gr",
    ρόλος: "προγραμματίστρια"
};

έστω προϊόν = {
    id: 101,
    όνομα: "HudHudScript IDE",
    έκδοση: "2.0",
    τιμή: 49
};

έστω παραγγελία = {
    id: 1001,
    id_χρήστη: 1,
    id_προϊόντος: 101,
    ποσότητα: 2,
    κατάσταση: "επιβεβαιωμένη"
};

συνάρτηση πληροφορίες_οντότητας(οντότητα) {
    επέστρεψε "Οντότητα #" + οντότητα.id + ": " + οντότητα.όνομα;
}

συνάρτηση υπολόγισε_σύνολο(παραγγελία, τιμή) {
    επέστρεψε παραγγελία.ποσότητα * τιμή;
}

εκτύπωσε("=== Σύστημα Οντοτήτων ===");
εκτύπωσε(πληροφορίες_οντότητας(χρήστης));
εκτύπωσε(πληροφορίες_οντότητας(προϊόν));
έστω σύνολο = υπολόγισε_σύνολο(παραγγελία, προϊόν.τιμή);
εκτύπωσε("Παραγγελία #" + παραγγελία.id + " σύνολο: " + σύνολο);
εκτύπωσε("Κατάσταση: " + παραγγελία.κατάσταση);
