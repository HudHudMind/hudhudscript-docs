// HI - Math Module

फ़ंक्शन add(a, b) {
    वापस_करो a + b;
}

फ़ंक्शन subtract(a, b) {
    वापस_करो a - b;
}

फ़ंक्शन multiply(a, b) {
    वापस_करो a * b;
}

फ़ंक्शन divide(a, b) {
    अगर (b == 0) {
        प्रिंट("Error: Division by zero!");
        वापस_करो 0;
    } नहीं_तो {
        वापस_करो a / b;
    }
}

फ़ंक्शन square(x) {
    वापस_करो x * x;
}

फ़ंक्शन cube(x) {
    वापस_करो x * x * x;
}

फ़ंक्शन abs(x) {
    अगर (x < 0) {
        वापस_करो -x;
    } नहीं_तो {
        वापस_करो x;
    }
}

फ़ंक्शन max(a, b) {
    अगर (a > b) {
        वापस_करो a;
    } नहीं_तो {
        वापस_करो b;
    }
}

फ़ंक्शन min(a, b) {
    अगर (a < b) {
        वापस_करो a;
    } नहीं_तो {
        वापस_करो b;
    }
}
