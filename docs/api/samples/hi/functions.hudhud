// हिन्दी - फ़ंक्शन
// फ़ंक्शन परिभाषा और उपयोग के उदाहरण

// सरल फ़ंक्शन
फ़ंक्शन नमस्कार() {
    प्रिंट("नमस्ते दुनिया!");
}

// पैरामीटर वाला फ़ंक्शन
फ़ंक्शन जोड़(अ, ब) {
    वापस अ + ब;
}

// बहु-पैरामीटर फ़ंक्शन
फ़ंक्शन गणना(संख्या१, संख्या२, क्रिया) {
    अगर (क्रिया == "जोड़") {
        वापस संख्या१ + संख्या२;
    } वरना {
        वापस ०;
    }
}

// गणितीय फ़ंक्शन
फ़ंक्शन वर्ग(ग) {
    वापस ग * ग;
}

फ़ंक्शन घन(ग) {
    वापस ग * ग * ग;
}

// फ़ंक्शन का उपयोग
नमस्कार();

मान परिणाम१ = जोड़(५, ३);
प्रिंट(परिणाम१);

मान परिणाम२ = गणना(१०, ५, "जोड़");
प्रिंट(परिणाम२);

मान वर्ग_परिणाम = वर्ग(४);
प्रिंट(वर्ग_परिणाम);

मान घन_परिणाम = घन(३);
प्रिंट(घन_परिणाम);

// फ़ंक्शन संयोजन
मान योग = जोड़(वर्ग(३), घन(२));
प्रिंट(योग);
