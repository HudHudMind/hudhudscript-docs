// हिन्दी - रिटर्न अवधारणा
// return

फ़ंक्शन वर्ग(x) {
    वापस x * x;
}

फ़ंक्शन घन(x) {
    वापस x * x * x;
}

प्रिंट("=== Math Functions ===");
प्रिंट("वर्ग(5): " + वर्ग(5));
प्रिंट("घन(3): " + घन(3));

फ़ंक्शन निरपेक्ष(x) {
    अगर (x < 0) {
        वापस -x;
    }
    वापस x;
}

प्रिंट("\n=== Absolute ===");
प्रिंट("निरपेक्ष(-7): " + निरपेक्ष(-7));
प्रिंट("निरपेक्ष(3): " + निरपेक्ष(3));

फ़ंक्शन बिंदु_बनाओ(x, y) {
    वापस { x: x, y: y };
}

मान p = बिंदु_बनाओ(10, 20);
प्रिंट("\n=== Point ===");
प्रिंट("Point: (" + p.x + ", " + p.y + ")");

फ़ंक्शन क्रमगुणित(n) {
    अगर (n <= 1) {
        वापस 1;
    }
    वापस n * क्रमगुणित(n - 1);
}

प्रिंट("\n=== Factorial ===");
प्रिंट("5! = " + क्रमगुणित(5));
प्रिंट("10! = " + क्रमगुणित(10));
