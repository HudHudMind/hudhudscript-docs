// বাংলা - অবজেক্ট
// Bengali - Objects with native keywords

// Create object
ধরো ব্যক্তি = {
    নাম: "রহিম",
    বয়স: 25,
    শহর: "ঢাকা"
};

// Access properties
ধরো নাম = ব্যক্তি.নাম;
ধরো বয়স = ব্যক্তি.বয়স;

// Another object
ধরো গাড়ি = {
    ব্র্যান্ড: "টয়োটা",
    বছর: 2023,
    রঙ: "নীল"
};
