// বাংলা - সত্তা ধারণা

ধরি ব্যবহারকারী = {
    আইডি: ১,
    নাম: "আয়েশা",
    ইমেইল: "ayesha@example.com",
    ভূমিকা: "ডেভেলপার"
};

ধরি পণ্য = {
    আইডি: ১০১,
    নাম: "হুদহুদস্ক্রিপ্ট আইডিই",
    সংস্করণ: "২.০",
    মূল্য: ৪৯
};

ধরি অর্ডার = {
    আইডি: ১০০১,
    ব্যবহারকারী_আইডি: ১,
    পণ্য_আইডি: ১০১,
    পরিমাণ: ২,
    অবস্থা: "নিশ্চিত"
};

ফাংশন সত্তা_তথ্য(সত্তা) {
    ফেরত "সত্তা #" + সত্তা.আইডি + ": " + সত্তা.নাম;
}

ফাংশন মোট_হিসাব(অর্ডার, মূল্য) {
    ফেরত অর্ডার.পরিমাণ * মূল্য;
}

প্রিন্ট("=== সত্তা সিস্টেম ===");
প্রিন্ট(সত্তা_তথ্য(ব্যবহারকারী));
প্রিন্ট(সত্তা_তথ্য(পণ্য));
ধরি মোট = মোট_হিসাব(অর্ডার, পণ্য.মূল্য);
প্রিন্ট("অর্ডার #" + অর্ডার.আইডি + " মোট: " + মোট);
প্রিন্ট("অবস্থা: " + অর্ডার.অবস্থা);
