// বাংলা - রিটার্ন ধারণা
// return

ফাংশন বর্গ(x) {
    ফেরত x * x;
}

ফাংশন ঘন(x) {
    ফেরত x * x * x;
}

প্রিন্ট("=== Math Functions ===");
প্রিন্ট("বর্গ(5): " + বর্গ(5));
প্রিন্ট("ঘন(3): " + ঘন(3));

ফাংশন পরম(x) {
    যদি (x < 0) {
        ফেরত -x;
    }
    ফেরত x;
}

প্রিন্ট("\n=== Absolute ===");
প্রিন্ট("পরম(-7): " + পরম(-7));
প্রিন্ট("পরম(3): " + পরম(3));

ফাংশন বিন্দু_তৈরি(x, y) {
    ফেরত { x: x, y: y };
}

ধরি p = বিন্দু_তৈরি(10, 20);
প্রিন্ট("\n=== Point ===");
প্রিন্ট("Point: (" + p.x + ", " + p.y + ")");

ফাংশন ফ্যাক্টরিয়াল(n) {
    যদি (n <= 1) {
        ফেরত 1;
    }
    ফেরত n * ফ্যাক্টরিয়াল(n - 1);
}

প্রিন্ট("\n=== Factorial ===");
প্রিন্ট("5! = " + ফ্যাক্টরিয়াল(5));
প্রিন্ট("10! = " + ফ্যাক্টরিয়াল(10));
