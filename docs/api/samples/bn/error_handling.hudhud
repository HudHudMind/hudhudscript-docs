// বাংলা - ত্রুটি পরিচালনা
// try/catch/finally, throw

// Basic try/catch
ফাংশন ভাগ(a, b) {
    যদি (b == 0) {
        ছুঁড়ো "শূন্য দিয়ে ভাগ ত্রুটি";
    }
    ফেরত a / b;
}

চেষ্টা {
    ধরি result = ভাগ(10, 2);
    প্রিন্ট("10 / 2 = " + result);
} ধরো (error) {
    প্রিন্ট("ত্রুটি: " + error);
}

// Try/catch/finally
প্রিন্ট("
=== ফাইল প্রক্রিয়াকরণ ===");

ফাংশন ফাইল_প্রক্রিয়া(filename) {
    যদি (filename == "") {
        ছুঁড়ো "খালি ফাইল নাম ত্রুটি";
    }
    প্রিন্ট("প্রক্রিয়াকরণ: " + filename);
    ফেরত "ডেটা উৎস " + filename;
}

চেষ্টা {
    ধরি data = ফাইল_প্রক্রিয়া("report.txt");
    প্রিন্ট("ফলাফল: " + data);
} ধরো (error) {
    প্রিন্ট("ত্রুটি: " + error);
} সবশেষে {
    প্রিন্ট("পরিষ্কার সম্পন্ন");
}

// Nested error handling
প্রিন্ট("
=== নেস্টেড ত্রুটি পরিচালনা ===");

চেষ্টা {
    প্রিন্ট("বাইরের চেষ্টা ব্লক");
    চেষ্টা {
        ছুঁড়ো "ভেতরের ত্রুটি";
    } ধরো (inner_err) {
        প্রিন্ট("ভেতরের ধরা হলো: " + inner_err);
        ছুঁড়ো "পুনরায় ছুঁড়ে দেওয়া ত্রুটি";
    }
} ধরো (outer_err) {
    প্রিন্ট("বাইরের ধরা হলো: " + outer_err);
} সবশেষে {
    প্রিন্ট("সব সম্পন্ন");
}
