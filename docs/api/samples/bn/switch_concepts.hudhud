// বাংলা - Switch/Case ধারণা
// switch/case/default

ফাংশন দিনের_ধরন(day) {
    বেছে_নাও (day) {
        ক্ষেত্রে "Monday":
        ক্ষেত্রে "Tuesday":
        ক্ষেত্রে "Wednesday":
        ক্ষেত্রে "Thursday":
        ক্ষেত্রে "Friday":
            ফেরত "কর্মদিবস";
        ক্ষেত্রে "Saturday":
        ক্ষেত্রে "Sunday":
            ফেরত "সপ্তাহান্ত";
        ডিফল্ট:
            ফেরত "অজানা";
    }
}

প্রিন্ট("=== Day Types ===");
প্রিন্ট("Monday: " + দিনের_ধরন("Monday"));
প্রিন্ট("Saturday: " + দিনের_ধরন("Saturday"));
প্রিন্ট("Holiday: " + দিনের_ধরন("Holiday"));

ফাংশন গ্রেড_অক্ষর(score) {
    বেছে_নাও (score) {
        ক্ষেত্রে 90:
            ফেরত "A";
        ক্ষেত্রে 80:
            ফেরত "B";
        ক্ষেত্রে 70:
            ফেরত "C";
        ক্ষেত্রে 60:
            ফেরত "D";
        ডিফল্ট:
            ফেরত "F";
    }
}

প্রিন্ট("\n=== Grades ===");
প্রিন্ট("90: " + গ্রেড_অক্ষর(90));
প্রিন্ট("70: " + গ্রেড_অক্ষর(70));
প্রিন্ট("50: " + গ্রেড_অক্ষর(50));

ফাংশন অবস্থা_বার্তা(code) {
    বেছে_নাও (code) {
        ক্ষেত্রে 200:
            ফেরত "OK";
        ক্ষেত্রে 404:
            ফেরত "Not Found";
        ক্ষেত্রে 500:
            ফেরত "Server Error";
        ডিফল্ট:
            ফেরত "অজানা Status";
    }
}

প্রিন্ট("\n=== HTTP Status ===");
প্রিন্ট("200: " + অবস্থা_বার্তা(200));
প্রিন্ট("404: " + অবস্থা_বার্তা(404));
