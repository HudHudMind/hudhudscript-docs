// Japanese - Switch/Case概念
// if-elseによる複数条件分岐

関数 曜日タイプ(曜日) {
    もし (曜日 == "月曜日") { 返す "平日"; }
    もし (曜日 == "火曜日") { 返す "平日"; }
    もし (曜日 == "水曜日") { 返す "平日"; }
    もし (曜日 == "木曜日") { 返す "平日"; }
    もし (曜日 == "金曜日") { 返す "平日"; }
    もし (曜日 == "土曜日") { 返す "週末"; }
    もし (曜日 == "日曜日") { 返す "週末"; }
    返す "不明";
}

表示("=== 曜日タイプ ===");
表示("月曜日: " + 曜日タイプ("月曜日"));
表示("土曜日: " + 曜日タイプ("土曜日"));

関数 ステータスメッセージ(コード) {
    もし (コード == 200) { 返す "OK"; }
    もし (コード == 404) { 返す "見つかりません"; }
    もし (コード == 500) { 返す "サーバーエラー"; }
    返す "不明なステータス";
}

表示("=== HTTPステータス ===");
表示("200: " + ステータスメッセージ(200));
表示("404: " + ステータスメッセージ(404));
