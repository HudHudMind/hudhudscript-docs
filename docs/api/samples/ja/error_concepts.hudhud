// Japanese - エラー概念
// 単純な検証関数

関数 年齢検証(年齢) {
    もし (年齢 < 0) {
        返す { 有効: 偽, エラー: "無効な年齢: 負の値" };
    }
    もし (年齢 > 150) {
        返す { 有効: 偽, エラー: "無効な年齢: 大きすぎる" };
    }
    返す { 有効: 真, 年齢: 年齢 };
}

表示("=== 検証 ===");

変数 年齢結果1 = 年齢検証(25);
もし (年齢結果1.有効) {
    表示("年齢25は有効です");
} そうでないなら {
    表示("エラー: " + 年齢結果1.エラー);
}

変数 年齢結果2 = 年齢検証(-5);
もし (年齢結果2.有効) {
    表示("年齢は有効です");
} そうでないなら {
    表示("エラー: " + 年齢結果2.エラー);
}

表示("検証完了");
