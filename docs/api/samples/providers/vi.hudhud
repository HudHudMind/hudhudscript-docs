// Tiếng Việt - providers.hudhud

nhà_cung_cấp DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    tên: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    nhiệt_độ: 0.8
}

nhà_cung_cấp AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    tên: "Anthropic Claude",
    model: "claude-opus-4.6",
    nhiệt_độ: 0.9
}

nhà_cung_cấp OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    tên: "OpenAI GPT",
    nhiệt_độ: 0.6
}
