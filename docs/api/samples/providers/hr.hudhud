// Hrvatski - providers.hudhud

pružatelj DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    ime: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    temperatura: 0.8
}

pružatelj AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    ime: "Anthropic Claude",
    model: "claude-opus-4.6",
    temperatura: 0.9
}

pružatelj OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    ime: "OpenAI GPT",
    temperatura: 0.6
}
