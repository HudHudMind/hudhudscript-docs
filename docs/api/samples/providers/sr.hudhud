// Српски - providers.hudhud

пружалац DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    име: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    температура: 0.8
}

пружалац AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    име: "Anthropic Claude",
    model: "claude-opus-4.6",
    температура: 0.9
}

пружалац OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    име: "OpenAI GPT",
    температура: 0.6
}
