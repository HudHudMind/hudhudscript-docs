// 包使用 - 哈德哈德脚本包系统
// 包管理系统: 创建、安装、发布和使用

// ============================================================
// 1. 使用包
// ============================================================

// 使用外部包
使用 "代数";
使用 "物理";

// 从包中导入特定模块
使用 "代数/矩阵";
使用 "代数/向量";
使用 "物理/运动";

打印("============================================================");
打印("哈德哈德脚本包系统演示");
打印("============================================================\n");

// ============================================================
// 2. 使用包函数
// ============================================================

打印("代数包使用:");
打印("─────────────────────────────────────────────────────────\n");

// 创建矩阵
变量 矩阵1 = 矩阵([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

变量 矩阵2 = 矩阵([
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]);

打印("矩阵 1:");
矩阵1.显示();

打印("\n矩阵 2:");
矩阵2.显示();

// 矩阵加法
变量 总和 = 矩阵1.加(矩阵2);
打印("\n矩阵加法:");
总和.显示();

// 向量运算
变量 向量1 = 向量([1, 2, 3]);
变量 向量2 = 向量([4, 5, 6]);

打印("\n\n向量运算:");
打印("─────────────────────────────────────────────────────────\n");

打印("向量 1: " + 向量1.转文字());
打印("向量 2: " + 向量2.转文字());

变量 点积 = 向量1.点积(向量2);
打印("点积: " + 点积);

变量 叉积 = 向量1.叉积(向量2);
打印("叉积: " + 叉积.转文字());

// ============================================================
// 3. 使用物理包
// ============================================================

打印("\n\n物理包使用:");
打印("─────────────────────────────────────────────────────────\n");

// 运动计算
变量 初速度 = 0;        // 米/秒
变量 加速度 = 9.8;      // 米/秒² (重力)
变量 时间 = 5;           // 秒

变量 末速度 = 运动.计算速度(初速度, 加速度, 时间);
变量 距离 = 运动.计算距离(初速度, 加速度, 时间);

打印("初速度: " + 初速度 + " 米/秒");
打印("加速度: " + 加速度 + " 米/秒²");
打印("时间: " + 时间 + " 秒");
打印("─────────────────────────────────────────────────────────");
打印("末速度: " + 末速度 + " 米/秒");
打印("行驶距离: " + 距离 + " 米");

// ============================================================
// 4. 创建包
// ============================================================

打印("\n\n创建包:");
打印("─────────────────────────────────────────────────────────\n");

打印("1. 创建 hudhud.toml 文件:");
打印("   [包]");
打印("   名称 = '数学工具'");
打印("   版本 = '1.0.0'");
打印("   描述 = '数学辅助函数'");

打印("\n2. 添加依赖:");
打印("   [依赖]");
打印("   代数 = '^2.0.0'");
打印("   物理 = '^1.5.0'");

// ============================================================
// 5. 包管理命令
// ============================================================

打印("\n\n包管理命令:");
打印("─────────────────────────────────────────────────────────\n");

打印("安装包:");
打印("  hudhudscript install 代数");
打印("  hudhudscript install 物理@1.5.0");

打印("\n更新包:");
打印("  hudhudscript update 代数");
打印("  hudhudscript update --all");

打印("\n删除包:");
打印("  hudhudscript remove 代数");

打印("\n列出已安装的包:");
打印("  hudhudscript list");

打印("\n搜索包:");
打印("  hudhudscript search 数学");

打印("\n包信息:");
打印("  hudhudscript info 代数");

// ============================================================
// 6. 包依赖
// ============================================================

打印("\n\n包依赖:");
打印("─────────────────────────────────────────────────────────\n");

打印("版本指定:");
打印("  '代数' = '^2.0.0'    # 2.x.x");
打印("  '物理' = '~1.5.0'    # 1.5.x");
打印("  '化学' = '1.2.3'     # 精确版本");

打印("\n从Git仓库:");
打印("  '我的库' = { git = 'https://github.com/user/my-lib' }");

打印("\n从本地路径:");
打印("  '本地库' = { path = '../本地库' }");

// ============================================================
// 7. 包安全
// ============================================================

打印("\n\n包安全:");
打印("─────────────────────────────────────────────────────────\n");

打印("安全审计:");
打印("  hudhudscript audit");

打印("\n校验和验证:");
打印("  hudhudscript verify 代数");

打印("\n============================================================");
打印("包系统演示完成!");
打印("使用哈德哈德脚本编写模块化和可重用的代码");
打印("============================================================");
