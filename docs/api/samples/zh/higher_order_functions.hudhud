// 中文 - 高阶函数
// 与其他函数协作的函数

// 返回函数的函数
函数 乘数器(因子) {
    返回 (x) => x * 因子;
}

变量 双倍 = 乘数器(2);
变量 三倍 = 乘数器(3);

打印(双倍(5));  // 10
打印(三倍(5));  // 15

// 接受函数的函数
函数 应用(函数参数, 值) {
    返回 函数参数(值);
}

打印(应用(双倍, 10));  // 20

// 组合示例
函数 组合(f, g) {
    返回 (x) => f(g(x));
}

变量 加一 = (x) => x + 1;
变量 乘二 = (x) => x * 2;

变量 先加后乘 = 组合(乘二, 加一);
打印(先加后乘(5));  // 12 (5+1=6, 6*2=12)
