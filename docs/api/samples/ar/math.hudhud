// العربية - وحدة الرياضيات

دالة اجمع(أ, ب) {
    ارجع أ + ب;
}

دالة اطرح(أ, ب) {
    ارجع أ - ب;
}

دالة اضرب(أ, ب) {
    ارجع أ * ب;
}

دالة اقسم(أ, ب) {
    إذا (ب == 0) {
        اطبع("خطأ: القسمة على صفر!");
        ارجع 0;
    } وإلا {
        ارجع أ / ب;
    }
}

دالة مربع(س) {
    ارجع س * س;
}

دالة مكعب(س) {
    ارجع س * س * س;
}

دالة قيمة_مطلقة(س) {
    إذا (س < 0) {
        ارجع -س;
    } وإلا {
        ارجع س;
    }
}

دالة الأكبر(أ, ب) {
    إذا (أ > ب) {
        ارجع أ;
    } وإلا {
        ارجع ب;
    }
}

دالة الأصغر(أ, ب) {
    إذا (أ < ب) {
        ارجع أ;
    } وإلا {
        ارجع ب;
    }
}
