// Arabic - إدارة الأخطاء
// التحكم في الأخطاء باستخدام if-else

// دالة للتحقق من الأخطاء
وظيفة تقسيم(أ، ب) {
    إذا (ب == 0) {
        إرجاع { خطأ: صحيح، رسالة: "خطأ القسمة على صفر"، قيمة: 0 };
    }
    إرجاع { خطأ: خطأ، رسالة: ""، قيمة: أ / ب };
}

اطبع("=== عملية القسمة ===");

// أول عملية قسمة
اطبع("عملية 10 / 2:");
متغير نتيجة1 = تقسيم(10، 2);
إذا (نتيجة1.خطأ) {
    اطبع("خطأ: " + نتيجة1.رسالة);
} وإلا {
    اطبع("10 / 2 = " + نتيجة1.قيمة);
}

// القسمة على صفر
اطبع("عملية 10 / 0:");
متغير نتيجة2 = تقسيم(10، 0);
إذا (نتيجة2.خطأ) {
    اطبع("تم اكتشاف الخطأ: " + نتيجة2.رسالة);
} وإلا {
    اطبع("النتيجة: " + نتيجة2.قيمة);
}

اطبع("تم الانتهاء");
