// العربية - معالجة البيانات
// معالجة البيانات بالكلمات المفتاحية العربية

// تعريف البيانات
متغير قيمة1 = 100;
متغير قيمة2 = 200;
متغير قيمة3 = 300;

// الحساب
متغير المجموع = قيمة1 + قيمة2 + قيمة3;
متغير المتوسط = المجموع / 3;

// المعالجة الشرطية
إذا (المتوسط > 150) {
    متغير الحالة = "مرتفع";
} وإلا {
    متغير الحالة = "منخفض";
}

اطبع("المجموع: " + المجموع);
اطبع("المتوسط: " + المتوسط);
اطبع("الحالة: " + الحالة);
