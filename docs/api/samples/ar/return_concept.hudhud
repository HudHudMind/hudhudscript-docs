// العربية - مفهوم الإرجاع
// ارجع

دالة مربع(س) {
    ارجع س * س;
}

دالة مكعب(س) {
    ارجع س * س * س;
}

اطبع("=== دوال رياضية ===");
اطبع("مربع(5): " + مربع(5));
اطبع("مكعب(3): " + مكعب(3));

دالة قيمة_مطلقة(س) {
    إذا (س < 0) {
        ارجع -س;
    }
    ارجع س;
}

اطبع("=== القيمة المطلقة ===");
اطبع("قيمة_مطلقة(-7): " + قيمة_مطلقة(-7));
اطبع("قيمة_مطلقة(3): " + قيمة_مطلقة(3));

دالة أنشئ_نقطة(س, ص) {
    ارجع { س: س, ص: ص };
}

متغير ن = أنشئ_نقطة(10, 20);
اطبع("=== نقطة ===");
اطبع("نقطة: (" + ن.س + ", " + ن.ص + ")");

دالة عاملي(ع) {
    إذا (ع <= 1) {
        ارجع 1;
    }
    ارجع ع * عاملي(ع - 1);
}

اطبع("=== العاملي ===");
اطبع("5! = " + عاملي(5));
اطبع("10! = " + عاملي(10));
