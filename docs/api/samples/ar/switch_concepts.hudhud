// Arabic - مفاهيم Switch/Case
// استخدام if-else للشروط المتعددة

وظيفة نوع_اليوم(يوم) {
    إذا (يوم == "الإثنين") { إرجاع "يوم عمل"; }
    إذا (يوم == "الثلاثاء") { إرجاع "يوم عمل"; }
    إذا (يوم == "الأربعاء") { إرجاع "يوم عمل"; }
    إذا (يوم == "الخميس") { إرجاع "يوم عمل"; }
    إذا (يوم == "الجمعة") { إرجاع "يوم عمل"; }
    إذا (يوم == "السبت") { إرجاع "عطلة نهاية الأسبوع"; }
    إذا (يوم == "الأحد") { إرجاع "عطلة نهاية الأسبوع"; }
    إرجاع "غير معروف";
}

اطبع("=== أنواع الأيام ===");
اطبع("الإثنين: " + نوع_اليوم("الإثنين"));
اطبع("السبت: " + نوع_اليوم("السبت"));

وظيفة حالة_الشبكة(كود) {
    إذا (كود == 200) { إرجاع "OK"; }
    إذا (كود == 404) { إرجاع "غير موجود"; }
    إذا (كود == 500) { إرجاع "خطأ في الخادم"; }
    إرجاع "حالة غير معروفة";
}

اطبع("=== حالة HTTP ===");
اطبع("200: " + حالة_الشبكة(200));
اطبع("404: " + حالة_الشبكة(404));
