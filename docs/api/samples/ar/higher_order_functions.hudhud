// العربية - دوال عالية الرتبة
// دوال تعمل مع دوال اخرى

// دالة تعيد دالة
dawl مضاعف(عامل) {
    arji (س) => س * عامل;
}

bila ضعف = مضاعف(2);
bila ثلاثة_اضعاف = مضاعف(3);

itbaa(ضعف(5));  // 10
itbaa(ثلاثة_اضعاف(5));  // 15

// دالة تاخذ دالة
dawl طبق(دالة, قيمة) {
    arji دالة(قيمة);
}

itbaa(طبق(ضعف, 10));  // 20

// مثال على التركيب
dawl ركب(د1, د2) {
    arji (س) => د1(د2(س));
}

bila اضف_واحد = (س) => س + 1;
bila اضرب_باثنين = (س) => س * 2;

bila اضف_ثم_اضرب = ركب(اضرب_باثنين, اضف_واحد);
itbaa(اضف_ثم_اضرب(5));  // 12 (5+1=6, 6*2=12)
