// Arabic - مفاهيم الخطأ
// دوال التحقق البسيطة

وظيفة التحقق_من_العمر(عمر) {
    إذا (عمر < 0) {
        إرجاع { صالح: خطأ، خطأ: "عمر غير صالح: سالب" };
    }
    إذا (عمر > 150) {
        إرجاع { صالح: خطأ، خطأ: "عمر غير صالح: كبير جداً" };
    }
    إرجاع { صالح: صحيح، عمر: عمر };
}

وظيفة التحقق_من_البريد(بريد) {
    إذا (بريد == "") {
        إرجاع { صالح: خطأ، خطأ: "بريد فارغ" };
    }
    إرجاع { صالح: صحيح، بريد: بريد };
}

اطبع("=== التحقق ===");

متغير نتيجة_العمر1 = التحقق_من_العمر(25);
إذا (نتيجة_العمر1.صالح) {
    اطبع("العمر 25 صالح");
} وإلا {
    اطبع("خطأ: " + نتيجة_العمر1.خطأ);
}

متغير نتيجة_العمر2 = التحقق_من_العمر(-5);
إذا (نتيجة_العمر2.صالح) {
    اطبع("العمر صالح");
} وإلا {
    اطبع("خطأ: " + نتيجة_العمر2.خطأ);
}

اطبع("اكتمل التحقق");
