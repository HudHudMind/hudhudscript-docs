// العربية - دوال السهم
// صياغة حديثة ومختصرة للدوال

// دالة سهم - صياغة قصيرة
bila جمع = (أ, ب) => أ + ب;
bila ضرب = (س, ص) => س * ص;

itbaa(جمع(5, 3));      // 8
itbaa(ضرب(4, 7)); // 28

// دالة سهم مع كتلة
bila حساب = (أ, ب) => {
    bila مجموع = أ + ب;
    bila حاصل_الضرب = أ * ب;
    arji مجموع + حاصل_الضرب;
};

bila نتيجة = حساب(5, 3);
itbaa(نتيجة);  // 23 (8 + 15)

// معامل واحد (لا حاجة لأقواس)
bila مربع = س => س * س;
itbaa(مربع(6));  // 36

// بدون معاملات
bila تحية = () => "مرحبا!";
itbaa(تحية());  // مرحبا!
