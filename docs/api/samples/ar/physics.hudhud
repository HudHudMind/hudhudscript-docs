// العربية - وحدة الفيزياء

دالة السرعة(مسافة, زمن) {
    ارجع مسافة / زمن;
}

دالة القوة(كتلة, تسارع) {
    ارجع كتلة * تسارع;
}

دالة الطاقة_الحركية(كتلة, سرعة) {
    ارجع 0.5 * كتلة * سرعة * سرعة;
}

دالة الطاقة_الكامنة(كتلة, جاذبية, ارتفاع) {
    ارجع كتلة * جاذبية * ارتفاع;
}

دالة الزخم(كتلة, سرعة) {
    ارجع كتلة * سرعة;
}
