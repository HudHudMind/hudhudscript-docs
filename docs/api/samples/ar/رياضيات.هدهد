// العربية - Math Module

دالة اجمع(a, b) {
    ارجع a + b;
}

دالة اطرح(a, b) {
    ارجع a - b;
}

دالة اضرب(a, b) {
    ارجع a * b;
}

دالة اقسم(a, b) {
    إذا (b == 0) {
        اطبع("Error: Division by zero!");
        ارجع 0;
    } وإلا {
        ارجع a / b;
    }
}

دالة مربع(x) {
    ارجع x * x;
}

دالة مكعب(x) {
    ارجع x * x * x;
}

دالة مطلق(x) {
    إذا (x < 0) {
        ارجع -x;
    } وإلا {
        ارجع x;
    }
}

دالة اكبر(a, b) {
    إذا (a > b) {
        ارجع a;
    } وإلا {
        ارجع b;
    }
}

دالة اصغر(a, b) {
    إذا (a < b) {
        ارجع a;
    } وإلا {
        ارجع b;
    }
}
