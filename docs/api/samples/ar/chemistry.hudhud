// العربية - وحدة الكيمياء

دالة الكتلة_المولارية(ذرات, الوزن_الذري) {
    ارجع ذرات * الوزن_الذري;
}

دالة التركيز(مولات, حجم) {
    ارجع مولات / حجم;
}

دالة الأس_الهيدروجيني(تركيز_الهيدروجين) {
    ارجع 14 - تركيز_الهيدروجين;
}

دالة الكثافة(كتلة, حجم) {
    ارجع كتلة / حجم;
}

دالة التخفيف(ت1, ح1, ح2) {
    ارجع (ت1 * ح1) / ح2;
}
