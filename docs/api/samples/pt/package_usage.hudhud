// Package Kullanımı - HudHudScript Paket Sistemi
// Paket yönetim sistemi: oluşturma, kurma, yayınlama ve kullanma

// ============================================================
// 1. PAKET KULLANIMI (Using Packages)
// ============================================================

// Harici pacote kullanımı
usar "cebir";
usar "fizik" como pacote;

// Paket içinden belirli modülleri içe aktarma
usar "cebir/matris";
usar "cebir/vektor";
usar "fizik/hareket";

escreve("============================================================");
escreve("HudHudScript Paket Sistemi Demo");
escreve("============================================================\n");

// ============================================================
// 2. PAKET FONKSİYONLARINI KULLANMA
// ============================================================

escreve("📦 Cebir Paketi Kullanımı:");
escreve("─────────────────────────────────────────────────────────\n");

// Matris oluşturma
variável matris1 = Matris([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

variável matris2 = Matris([
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]);

escreve("Matris 1:");
matris1.goster();

escreve("\nMatris 2:");
matris2.goster();

// Matris toplama
variável toplam = matris1.topla(matris2);
escreve("\nMatris Toplama:");
toplam.goster();

// Vektör işlemleri
variável vektor1 = Vektor([1, 2, 3]);
variável vektor2 = Vektor([4, 5, 6]);

escreve("\n\n📐 Vektör İşlemleri:");
escreve("─────────────────────────────────────────────────────────\n");

escreve("Vektör 1: " + vektor1.toString());
escreve("Vektör 2: " + vektor2.toString());

variável noktaSal = vektor1.noktaSal(vektor2);
escreve("Nokta Çarpım: " + noktaSal);

variável caprazCarpim = vektor1.caprazCarpim(vektor2);
escreve("Çapraz Çarpım: " + caprazCarpim.toString());

// ============================================================
// 3. FİZİK PAKETİ KULLANIMI
// ============================================================

escreve("\n\n⚡ Fizik Paketi Kullanımı:");
escreve("─────────────────────────────────────────────────────────\n");

// Hareket hesaplamaları
variável baslangicHizi = 0;      // m/s
variável ivme = 9.8;              // m/s² (yerçekimi)
variável zaman = 5;               // saniye

variável sonHiz = Hareket.hizHesapla(baslangicHizi, ivme, zaman);
variável mesafe = Hareket.mesafeHesapla(baslangicHizi, ivme, zaman);

escreve("Başlangıç Hızı: " + baslangicHizi + " m/s");
escreve("İvme: " + ivme + " m/s²");
escreve("Zaman: " + zaman + " s");
escreve("─────────────────────────────────────────────────────────");
escreve("Son Hız: " + sonHiz + " m/s");
escreve("Alınan Mesafe: " + mesafe + " m");

// ============================================================
// 4. PAKET OLUŞTURMA (Package Creation)
// ============================================================

escreve("\n\n📝 Paket Oluşturma:");
escreve("─────────────────────────────────────────────────────────\n");

escreve("1. hudhud.toml dosyası oluşturun:");
escreve("   [package]");
escreve("   name = 'matematik-utils'");
escreve("   version = '1.0.0'");
escreve("   description = 'Matematik yardımcı fonksiyonları'");

escreve("\n2. Bağımlılıklar ekleyin:");
escreve("   [dependencies]");
escreve("   cebir = '^2.0.0'");
escreve("   fizik = '^1.5.0'");

// ============================================================
// 5. PAKET YÖNETİMİ KOMUTLARI
// ============================================================

escreve("\n\n🔧 Paket Yönetimi Komutları:");
escreve("─────────────────────────────────────────────────────────\n");

escreve("Paket kurma:");
escreve("  hudhudscript install cebir");
escreve("  hudhudscript install fizik@1.5.0");

escreve("\nPaket güncelleme:");
escreve("  hudhudscript update cebir");
escreve("  hudhudscript update --all");

escreve("\nPaket kaldırma:");
escreve("  hudhudscript remove cebir");

escreve("\nKurulu paketleri listeleme:");
escreve("  hudhudscript list");

escreve("\nPaket arama:");
escreve("  hudhudscript search matematik");

escreve("\nPaket bilgisi:");
escreve("  hudhudscript info cebir");

// ============================================================
// 6. PAKET BAĞIMLILIKLARI
// ============================================================

escreve("\n\n🔗 Paket Bağımlılıkları:");
escreve("─────────────────────────────────────────────────────────\n");

escreve("Versiyon belirtme:");
escreve("  'cebir' = '^2.0.0'    # 2.x.x");
escreve("  'fizik' = '~1.5.0'    # 1.5.x");
escreve("  'kimya' = '1.2.3'     # Tam versiyon");

escreve("\nGit deposundan:");
escreve("  'my-lib' = { git = 'https://github.com/user/my-lib' }");

escreve("\nYerel yoldan:");
escreve("  'local-lib' = { path = '../local-lib' }");

// ============================================================
// 7. PAKET GÜVENLİĞİ
// ============================================================

escreve("\n\n🔒 Paket Güvenliği:");
escreve("─────────────────────────────────────────────────────────\n");

escreve("Güvenlik kontrolü:");
escreve("  hudhudscript audit");

escreve("\nChecksum doğrulama:");
escreve("  hudhudscript verify cebir");

escreve("\n============================================================");
escreve("✓ Paket sistemi demo tamamlandı!");
escreve("✓ HudHudScript ile modüler ve yeniden kullanılabilir kod yazın");
escreve("============================================================");
