// ภาษาไทย - แนวคิด Switch/Case
// switch/case/default

ฟังก์ชัน ประเภท_วัน(day) {
    เลือก (day) {
        กรณี "Monday":
        กรณี "Tuesday":
        กรณี "Wednesday":
        กรณี "Thursday":
        กรณี "Friday":
            คืน "วันธรรมดา";
        กรณี "Saturday":
        กรณี "Sunday":
            คืน "สุดสัปดาห์";
        ค่าเริ่มต้น:
            คืน "ไม่ทราบ";
    }
}

พิมพ์("=== Day Types ===");
พิมพ์("Monday: " + ประเภท_วัน("Monday"));
พิมพ์("Saturday: " + ประเภท_วัน("Saturday"));
พิมพ์("Holiday: " + ประเภท_วัน("Holiday"));

ฟังก์ชัน เกรด_ตัวอักษร(score) {
    เลือก (score) {
        กรณี 90:
            คืน "A";
        กรณี 80:
            คืน "B";
        กรณี 70:
            คืน "C";
        กรณี 60:
            คืน "D";
        ค่าเริ่มต้น:
            คืน "F";
    }
}

พิมพ์("\n=== Grades ===");
พิมพ์("90: " + เกรด_ตัวอักษร(90));
พิมพ์("70: " + เกรด_ตัวอักษร(70));
พิมพ์("50: " + เกรด_ตัวอักษร(50));

ฟังก์ชัน ข้อความ_สถานะ(code) {
    เลือก (code) {
        กรณี 200:
            คืน "OK";
        กรณี 404:
            คืน "Not Found";
        กรณี 500:
            คืน "Server Error";
        ค่าเริ่มต้น:
            คืน "ไม่ทราบ Status";
    }
}

พิมพ์("\n=== HTTP Status ===");
พิมพ์("200: " + ข้อความ_สถานะ(200));
พิมพ์("404: " + ข้อความ_สถานะ(404));
