// ภาษาไทย - แนวคิดการคืนค่า
// return

ฟังก์ชัน กำลังสอง(x) {
    คืน x * x;
}

ฟังก์ชัน กำลังสาม(x) {
    คืน x * x * x;
}

พิมพ์("=== Math Functions ===");
พิมพ์("กำลังสอง(5): " + กำลังสอง(5));
พิมพ์("กำลังสาม(3): " + กำลังสาม(3));

ฟังก์ชัน ค่าสัมบูรณ์(x) {
    ถ้า (x < 0) {
        คืน -x;
    }
    คืน x;
}

พิมพ์("\n=== Absolute ===");
พิมพ์("ค่าสัมบูรณ์(-7): " + ค่าสัมบูรณ์(-7));
พิมพ์("ค่าสัมบูรณ์(3): " + ค่าสัมบูรณ์(3));

ฟังก์ชัน สร้าง_จุด(x, y) {
    คืน { x: x, y: y };
}

ให้ p = สร้าง_จุด(10, 20);
พิมพ์("\n=== Point ===");
พิมพ์("Point: (" + p.x + ", " + p.y + ")");

ฟังก์ชัน แฟกทอเรียล(n) {
    ถ้า (n <= 1) {
        คืน 1;
    }
    คืน n * แฟกทอเรียล(n - 1);
}

พิมพ์("\n=== Factorial ===");
พิมพ์("5! = " + แฟกทอเรียล(5));
พิมพ์("10! = " + แฟกทอเรียล(10));
