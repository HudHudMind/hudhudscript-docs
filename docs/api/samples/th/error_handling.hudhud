// ภาษาไทย - การจัดการข้อผิดพลาด
// try/catch/finally, throw

// Basic try/catch
ฟังก์ชัน หาร(a, b) {
    ถ้า (b == 0) {
        โยน "ข้อผิดพลาดหารด้วยศูนย์";
    }
    คืน a / b;
}

ลอง {
    ให้ result = หาร(10, 2);
    พิมพ์("10 / 2 = " + result);
} จับ (error) {
    พิมพ์("ข้อผิดพลาด: " + error);
}

// Try/catch/finally
พิมพ์("
=== การประมวลผลไฟล์ ===");

ฟังก์ชัน ประมวลผล_ไฟล์(filename) {
    ถ้า (filename == "") {
        โยน "ข้อผิดพลาดชื่อไฟล์ว่าง";
    }
    พิมพ์("กำลังประมวลผล: " + filename);
    คืน "ข้อมูลจาก " + filename;
}

ลอง {
    ให้ data = ประมวลผล_ไฟล์("report.txt");
    พิมพ์("ผลลัพธ์: " + data);
} จับ (error) {
    พิมพ์("ข้อผิดพลาด: " + error);
} ในที่สุด {
    พิมพ์("เสร็จสิ้นการล้าง");
}

// Nested error handling
พิมพ์("
=== การจัดการข้อผิดพลาดซ้อน ===");

ลอง {
    พิมพ์("บล็อกลองภายนอก");
    ลอง {
        โยน "ข้อผิดพลาดภายใน";
    } จับ (inner_err) {
        พิมพ์("จับภายใน: " + inner_err);
        โยน "ข้อผิดพลาดโยนซ้ำ";
    }
} จับ (outer_err) {
    พิมพ์("จับภายนอก: " + outer_err);
} ในที่สุด {
    พิมพ์("เสร็จทั้งหมด");
}
