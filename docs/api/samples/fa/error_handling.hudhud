// فارسی - مدیریت خطا
// try/catch/finally, throw

// Basic try/catch
تابع تقسیم(a, b) {
    اگر (b == 0) {
        پرتاب "خطای تقسیم بر صفر";
    }
    برگردان a / b;
}

امتحان {
    بگذار result = تقسیم(10, 2);
    چاپ("10 / 2 = " + result);
} بگیر (error) {
    چاپ("خطا: " + error);
}

// Try/catch/finally
چاپ("
=== پردازش فایل ===");

تابع پردازش_فایل(filename) {
    اگر (filename == "") {
        پرتاب "خطای نام فایل خالی";
    }
    چاپ("در حال پردازش: " + filename);
    برگردان "داده از " + filename;
}

امتحان {
    بگذار data = پردازش_فایل("report.txt");
    چاپ("نتیجه: " + data);
} بگیر (error) {
    چاپ("خطا: " + error);
} در_نهایت {
    چاپ("پاکسازی کامل شد");
}

// Nested error handling
چاپ("
=== مدیریت خطای تودرتو ===");

امتحان {
    چاپ("بلوک تلاش خارجی");
    امتحان {
        پرتاب "خطای داخلی";
    } بگیر (inner_err) {
        چاپ("خطای داخلی گرفته شد: " + inner_err);
        پرتاب "خطای پرتاب مجدد";
    }
} بگیر (outer_err) {
    چاپ("خطای خارجی گرفته شد: " + outer_err);
} در_نهایت {
    چاپ("همه انجام شد");
}
