// فارسی - توابع
// نمونه‌های تعریف و استفاده از توابع

// تابع ساده
تابع سلام_بگو() {
    چاپ("سلام دنیا!");
}

// تابع با پارامترها
تابع جمع(الف, ب) {
    برگردان الف + ب;
}

// تابع با تفریق
تابع تفریق(الف, ب) {
    برگردان الف - ب;
}

// توابع ریاضی
تابع مربع(ع) {
    برگردان ع * ع;
}

تابع مکعب(ع) {
    برگردان ع * ع * ع;
}

// استفاده از توابع
سلام_بگو();

بگذار نتیجه۱ = جمع(۵, ۳);
چاپ(نتیجه۱);

بگذار نتیجه۲ = تفریق(۱۰, ۵);
چاپ(نتیجه۲);

بگذار نتیجه_مربع = مربع(۴);
چاپ(نتیجه_مربع);

بگذار نتیجه_مکعب = مکعب(۳);
چاپ(نتیجه_مکعب);

// ترکیب توابع
بگذار مجموع = جمع(مربع(۳), مکعب(۲));
چاپ(مجموع);
