// فارسی - مفاهیم انتخاب
// switch/case/default

تابع نوع_روز(day) {
    انتخاب (day) {
        حالت "Monday":
        حالت "Tuesday":
        حالت "Wednesday":
        حالت "Thursday":
        حالت "Friday":
            برگردان "روز کاری";
        حالت "Saturday":
        حالت "Sunday":
            برگردان "آخر هفته";
        پیش_فرض:
            برگردان "ناشناخته";
    }
}

چاپ("=== Day Types ===");
چاپ("Monday: " + نوع_روز("Monday"));
چاپ("Saturday: " + نوع_روز("Saturday"));
چاپ("Holiday: " + نوع_روز("Holiday"));

تابع حرف_نمره(score) {
    انتخاب (score) {
        حالت 90:
            برگردان "A";
        حالت 80:
            برگردان "B";
        حالت 70:
            برگردان "C";
        حالت 60:
            برگردان "D";
        پیش_فرض:
            برگردان "F";
    }
}

چاپ("\n=== Grades ===");
چاپ("90: " + حرف_نمره(90));
چاپ("70: " + حرف_نمره(70));
چاپ("50: " + حرف_نمره(50));

تابع پیام_وضعیت(code) {
    انتخاب (code) {
        حالت 200:
            برگردان "OK";
        حالت 404:
            برگردان "Not Found";
        حالت 500:
            برگردان "Server Error";
        پیش_فرض:
            برگردان "ناشناخته Status";
    }
}

چاپ("\n=== HTTP Status ===");
چاپ("200: " + پیام_وضعیت(200));
چاپ("404: " + پیام_وضعیت(404));
