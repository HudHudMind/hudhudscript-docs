// Turkce - Yuksek Dereceli Fonksiyonlar
// Diger fonksiyonlarla calisan fonksiyonlar

// Fonksiyon donduren fonksiyon
islev carpan(faktör) {
    dön (x) => x * faktör;
}

tanim ikiye = carpan(2);
tanim üçe = carpan(3);

yazdir(ikiye(5));  // 10
yazdir(üçe(5));  // 15

// Fonksiyon alan fonksiyon
islev uygula(fn, değer) {
    dön fn(değer);
}

yazdir(uygula(ikiye, 10));  // 20

// Bilesim ornegi
islev birleştir(f, g) {
    dön (x) => f(g(x));
}

tanim birEkle = (x) => x + 1;
tanim ikiyleÇarp = (x) => x * 2;

tanim ekleSonraÇarp = birleştir(ikiyleÇarp, birEkle);
yazdir(ekleSonraÇarp(5));  // 12 (5+1=6, 6*2=12)
