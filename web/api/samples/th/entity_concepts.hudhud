// ภาษาไทย - แนวคิดเอนทิตี

ให้ ผู้ใช้ = {
    รหัส: ๑,
    ชื่อ: "อรุณ",
    อีเมล: "arun@tuayang.com",
    บทบาท: "นักพัฒนา"
};

ให้ ผลิตภัณฑ์ = {
    รหัส: ๑๐๑,
    ชื่อ: "ฮุดฮุดสคริปต์ ไอดีอี",
    เวอร์ชัน: "๒.๐",
    ราคา: ๔๙
};

ให้ คำสั่งซื้อ = {
    รหัส: ๑๐๐๑,
    รหัส_ผู้ใช้: ๑,
    รหัส_ผลิตภัณฑ์: ๑๐๑,
    จำนวน: ๒,
    สถานะ: "ยืนยันแล้ว"
};

ฟังก์ชัน ข้อมูล_เอนทิตี(เอนทิตี) {
    คืน "เอนทิตี #" + เอนทิตี.รหัส + ": " + เอนทิตี.ชื่อ;
}

ฟังก์ชัน คำนวณ_รวม(คำสั่งซื้อ, ราคา) {
    คืน คำสั่งซื้อ.จำนวน * ราคา;
}

พิมพ์("=== ระบบเอนทิตี ===");
พิมพ์(ข้อมูล_เอนทิตี(ผู้ใช้));
พิมพ์(ข้อมูล_เอนทิตี(ผลิตภัณฑ์));
ให้ รวม = คำนวณ_รวม(คำสั่งซื้อ, ผลิตภัณฑ์.ราคา);
พิมพ์("คำสั่งซื้อ #" + คำสั่งซื้อ.รหัส + " รวม: " + รวม);
พิมพ์("สถานะ: " + คำสั่งซื้อ.สถานะ);
