// বাংলা - উন্নত লুপ ধারণা
// Bengali - Advanced Loop Concepts with native keywords

// যতক্ষণ লুপ
ধরো গণনা = 0;
যতক্ষণ (গণনা < 5) {
    গণনা = গণনা + 1;
}

// জন্য লুপ (যখন দিয়ে)
ধরো i = 0;
যতক্ষণ (i < 10) {
    ধরো মান = i * 2;
    i = i + 1;
}

// নেস্টেড লুপ
ধরো সারি = 0;
যতক্ষণ (সারি < 3) {
    ধরো কলাম = 0;
    যতক্ষণ (কলাম < 3) {
        ধরো গুণফল = সারি * কলাম;
        কলাম = কলাম + 1;
    }
    সারি = সারি + 1;
}

// শর্তসাপেক্ষ লুপ
ধরো j = 0;
যতক্ষণ (j < 100) {
    যদি (j == 10) {
        ধরো থামানো = true;
    }
    j = j + 1;
}

// এড়িয়ে যাওয়া লুপ
ধরো k = 0;
যতক্ষণ (k < 10) {
    k = k + 1;
    যদি (k == 5) {
        ধরো এড়িয়ে = true;
    } নাহলে {
        ধরো প্রক্রিয়া = k;
    }
}

// অ্যারে লুপ
ধরো সংখ্যা = [1, 2, 3, 4, 5];
ধরো idx = 0;
যতক্ষণ (idx < 5) {
    ধরো মান = সংখ্যা[idx];
    idx = idx + 1;
}
