// বাংলা - পদার্থবিদ্যা মডিউল

ফাংশন গতি(দূরত্ব, সময়) {
    ফেরত দূরত্ব / সময়;
}

ফাংশন বল(ভর, ত্বরণ) {
    ফেরত ভর * ত্বরণ;
}

ফাংশন গতিশক্তি(ভর, বেগ) {
    ফেরত ০.৫ * ভর * বেগ * বেগ;
}

ফাংশন বিভবশক্তি(ভর, মাধ্যাকর্ষণ, উচ্চতা) {
    ফেরত ভর * মাধ্যাকর্ষণ * উচ্চতা;
}

ফাংশন ভরবেগ(ভর, বেগ) {
    ফেরত ভর * বেগ;
}
