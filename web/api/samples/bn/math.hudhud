// বাংলা - গণিত মডিউল

ফাংশন যোগ(ক, খ) {
    ফেরত ক + খ;
}

ফাংশন বিয়োগ(ক, খ) {
    ফেরত ক - খ;
}

ফাংশন গুণ(ক, খ) {
    ফেরত ক * খ;
}

ফাংশন ভাগ(ক, খ) {
    যদি (খ == 0) {
        প্রিন্ট("ত্রুটি: শূন্য দিয়ে ভাগ!");
        ফেরত 0;
    } নাহলে {
        ফেরত ক / খ;
    }
}

ফাংশন বর্গ(স) {
    ফেরত স * স;
}

ফাংশন ঘন(স) {
    ফেরত স * স * স;
}

ফাংশন পরম_মান(স) {
    যদি (স < 0) {
        ফেরত -স;
    } নাহলে {
        ফেরত স;
    }
}

ফাংশন সর্বোচ্চ(ক, খ) {
    যদি (ক > খ) {
        ফেরত ক;
    } নাহলে {
        ফেরত খ;
    }
}

ফাংশন সর্বনিম্ন(ক, খ) {
    যদি (ক < খ) {
        ফেরত ক;
    } নাহলে {
        ফেরত খ;
    }
}
