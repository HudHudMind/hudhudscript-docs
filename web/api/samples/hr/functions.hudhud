// Hrvatski - Funkcije
// Primjeri definiranja i korištenja funkcija

// Jednostavna funkcija
funkcija pozdravi() {
    ispiši("Zdravo Svijete!");
}

// Funkcija s parametrima
funkcija zbroji(a, b) {
    vrati a + b;
}

// Višeparametarska funkcija
funkcija izračunaj(broj1, broj2, operacija) {
    ako (operacija == "zbroji") {
        vrati broj1 + broj2;
    } inače {
        vrati 0;
    }
}

// Matematičke funkcije
funkcija kvadrat(x) {
    vrati x * x;
}

funkcija kub(x) {
    vrati x * x * x;
}

// Korištenje funkcija
pozdravi();

neka rezultat1 = zbroji(5, 3);
ispiši(rezultat1);

neka rezultat2 = izračunaj(10, 5, "zbroji");
ispiši(rezultat2);

neka rezultat_kvadrat = kvadrat(4);
ispiši(rezultat_kvadrat);

neka rezultat_kub = kub(3);
ispiši(rezultat_kub);

// Kompozicija funkcija
neka ukupno = zbroji(kvadrat(3), kub(2));
ispiši(ukupno);
