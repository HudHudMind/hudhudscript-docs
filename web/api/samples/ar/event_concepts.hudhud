// العربية - مفاهيم الأحداث

حدث تسجيل_دخول {
    اطبع("تم تسجيل الدخول");
}

حدث استلام_بيانات {
    اطبع("تم استلام البيانات");
}

حدث حدوث_خطأ {
    اطبع("حدث خطأ");
}

دالة عند_تسجيل(اسم_مستخدم) {
    اطبع("تسجيل دخول: " + اسم_مستخدم);
    ارجع "مرحباً, " + اسم_مستخدم;
}

دالة عند_بيانات(مصدر) {
    اطبع("بيانات من: " + مصدر);
    ارجع "تمت المعالجة: " + مصدر;
}

دالة عند_خطأ(رسالة) {
    اطبع("خطأ: " + رسالة);
    ارجع "تمت المعالجة: " + رسالة;
}

اطبع("=== نظام الأحداث ===");
متغير ن1 = عند_تسجيل("المشرف");
اطبع(ن1);
متغير ن2 = عند_بيانات("المستشعر_1");
اطبع(ن2);
متغير ن3 = عند_خطأ("انتهت المهلة");
اطبع(ن3);
