// استخدام الحزم - نظام حزم هدهد سكريبت
// نظام إدارة الحزم: إنشاء، تثبيت، نشر واستخدام

// ============================================================
// 1. استخدام الحزم
// ============================================================

// استخدام حزمة خارجية
استخدم "جبر";
استخدم "فيزياء";

// استيراد وحدات محددة من الحزمة
استخدم "جبر/مصفوفة";
استخدم "جبر/متجه";
استخدم "فيزياء/حركة";

اطبع("============================================================");
اطبع("عرض نظام حزم هدهد سكريبت");
اطبع("============================================================\n");

// ============================================================
// 2. استخدام دوال الحزم
// ============================================================

اطبع("استخدام حزمة الجبر:");
اطبع("─────────────────────────────────────────────────────────\n");

// إنشاء مصفوفة
متغير مصفوفة1 = مصفوفة([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

متغير مصفوفة2 = مصفوفة([
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]);

اطبع("المصفوفة 1:");
مصفوفة1.اعرض();

اطبع("\nالمصفوفة 2:");
مصفوفة2.اعرض();

// جمع المصفوفات
متغير المجموع = مصفوفة1.اجمع(مصفوفة2);
اطبع("\nجمع المصفوفات:");
المجموع.اعرض();

// عمليات المتجهات
متغير متجه1 = متجه([1, 2, 3]);
متغير متجه2 = متجه([4, 5, 6]);

اطبع("\n\nعمليات المتجهات:");
اطبع("─────────────────────────────────────────────────────────\n");

اطبع("المتجه 1: " + متجه1.نص());
اطبع("المتجه 2: " + متجه2.نص());

متغير الجداء_النقطي = متجه1.جداء_نقطي(متجه2);
اطبع("الجداء النقطي: " + الجداء_النقطي);

متغير الجداء_التقاطعي = متجه1.جداء_تقاطعي(متجه2);
اطبع("الجداء التقاطعي: " + الجداء_التقاطعي.نص());

// ============================================================
// 3. استخدام حزمة الفيزياء
// ============================================================

اطبع("\n\nاستخدام حزمة الفيزياء:");
اطبع("─────────────────────────────────────────────────────────\n");

// حسابات الحركة
متغير السرعة_الابتدائية = 0;      // م/ث
متغير التسارع = 9.8;               // م/ث² (الجاذبية)
متغير الزمن = 5;                    // ثانية

متغير السرعة_النهائية = حركة.احسب_السرعة(السرعة_الابتدائية, التسارع, الزمن);
متغير المسافة = حركة.احسب_المسافة(السرعة_الابتدائية, التسارع, الزمن);

اطبع("السرعة الابتدائية: " + السرعة_الابتدائية + " م/ث");
اطبع("التسارع: " + التسارع + " م/ث²");
اطبع("الزمن: " + الزمن + " ث");
اطبع("─────────────────────────────────────────────────────────");
اطبع("السرعة النهائية: " + السرعة_النهائية + " م/ث");
اطبع("المسافة المقطوعة: " + المسافة + " م");

// ============================================================
// 4. إنشاء الحزم
// ============================================================

اطبع("\n\nإنشاء الحزم:");
اطبع("─────────────────────────────────────────────────────────\n");

اطبع("1. أنشئ ملف hudhud.toml:");
اطبع("   [حزمة]");
اطبع("   الاسم = 'أدوات-رياضية'");
اطبع("   الإصدار = '1.0.0'");
اطبع("   الوصف = 'دوال مساعدة للرياضيات'");

اطبع("\n2. أضف التبعيات:");
اطبع("   [تبعيات]");
اطبع("   جبر = '^2.0.0'");
اطبع("   فيزياء = '^1.5.0'");

// ============================================================
// 5. أوامر إدارة الحزم
// ============================================================

اطبع("\n\nأوامر إدارة الحزم:");
اطبع("─────────────────────────────────────────────────────────\n");

اطبع("تثبيت حزمة:");
اطبع("  hudhudscript install جبر");
اطبع("  hudhudscript install فيزياء@1.5.0");

اطبع("\nتحديث حزمة:");
اطبع("  hudhudscript update جبر");
اطبع("  hudhudscript update --all");

اطبع("\nإزالة حزمة:");
اطبع("  hudhudscript remove جبر");

اطبع("\nعرض الحزم المثبتة:");
اطبع("  hudhudscript list");

اطبع("\nالبحث عن حزمة:");
اطبع("  hudhudscript search رياضيات");

اطبع("\nمعلومات الحزمة:");
اطبع("  hudhudscript info جبر");

// ============================================================
// 6. تبعيات الحزم
// ============================================================

اطبع("\n\nتبعيات الحزم:");
اطبع("─────────────────────────────────────────────────────────\n");

اطبع("تحديد الإصدار:");
اطبع("  'جبر' = '^2.0.0'    # 2.x.x");
اطبع("  'فيزياء' = '~1.5.0'    # 1.5.x");
اطبع("  'كيمياء' = '1.2.3'     # إصدار محدد");

اطبع("\nمن مستودع جت:");
اطبع("  'مكتبتي' = { git = 'https://github.com/user/my-lib' }");

اطبع("\nمن مسار محلي:");
اطبع("  'مكتبة-محلية' = { path = '../مكتبة-محلية' }");

// ============================================================
// 7. أمان الحزم
// ============================================================

اطبع("\n\nأمان الحزم:");
اطبع("─────────────────────────────────────────────────────────\n");

اطبع("فحص الأمان:");
اطبع("  hudhudscript audit");

اطبع("\nالتحقق من المجموع:");
اطبع("  hudhudscript verify جبر");

اطبع("\n============================================================");
اطبع("تم الانتهاء من عرض نظام الحزم!");
اطبع("اكتب كودًا معياريًا وقابلًا لإعادة الاستخدام مع هدهد سكريبت");
اطبع("============================================================");
