// العربية - وكيل خدمة العملاء
استخدم "providers.hudhud";

قانون قانون_الاحترام {
    وصف: "يجب أن يكون الوكيل مهذباً ومحترماً",
    أولوية: 1
}

دستور دستور_الخدمة {
    قوانين: [قانون_الاحترام],
    وصف: "إطار خدمة العملاء"
}

وكيل وكيل_الخدمة {
    مزود: OpenAIProvider,
    model: "gpt-4"
}

دالة رحب(اسم_العميل) {
    متغير رسالة = "مرحباً " + اسم_العميل + "، كيف يمكنني مساعدتك؟";
    اطبع(رسالة);
    ارجع رسالة;
}

دالة عالج_طلب(نوع, تفاصيل) {
    إذا (نوع == "شكوى") {
        اطبع("أعتذر عن الإزعاج. سأساعدك في حل المشكلة.");
    } وإلا {
        اطبع("شكراً لتواصلك. سأعالج طلبك الآن.");
    }
    ارجع "تمت معالجة: " + نوع + " - " + تفاصيل;
}

اطبع("=== وكيل خدمة العملاء ===");
اطبع(وكيل_الخدمة.model + " عبر " + وكيل_الخدمة.مزود.اسم);
رحب("أحمد");
متغير نتيجة = عالج_طلب("شكوى", "تأخر الشحن");
اطبع(نتيجة);
