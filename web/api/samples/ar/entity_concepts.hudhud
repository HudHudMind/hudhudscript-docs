// العربية - مفاهيم الكيانات

متغير مستخدم = {
    معرف: 1,
    اسم: "علياء",
    بريد: "aliyaa@example.com",
    دور: "مطورة"
};

متغير منتج = {
    معرف: 101,
    اسم: "محرر هدهد سكريبت",
    إصدار: "2.0",
    سعر: 49
};

متغير طلب = {
    معرف: 1001,
    معرف_مستخدم: 1,
    معرف_منتج: 101,
    كمية: 2,
    حالة: "مؤكد"
};

دالة معلومات_كيان(كيان) {
    ارجع "كيان #" + كيان.معرف + ": " + كيان.اسم;
}

دالة احسب_المجموع(طلب, سعر) {
    ارجع طلب.كمية * سعر;
}

اطبع("=== نظام الكيانات ===");
اطبع(معلومات_كيان(مستخدم));
اطبع(معلومات_كيان(منتج));
متغير المجموع = احسب_المجموع(طلب, منتج.سعر);
اطبع("طلب #" + طلب.معرف + " المجموع: " + المجموع);
اطبع("الحالة: " + طلب.حالة);
