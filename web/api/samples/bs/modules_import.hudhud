// BS - Modules Import Example

// Import math module (direct access)
koristi "math.hudhud";

// Import physics with alias (access via fizik.functionName)
koristi "physics.hudhud" kao fizik;

// Import chemistry (direct access)
koristi "chemistry.hudhud";

// Using math functions (direct)
neka sum = add(10, 5);
štampaj(sum);

neka product = multiply(4, 7);
štampaj(product);

// Using physics functions (via alias: fizik.functionName)
neka f = fizik.force(10, 9.8);
štampaj(f);

neka ke = fizik.kineticEnergy(5, 10);
štampaj(ke);

// Using chemistry functions (direct)
neka d = density(100, 50);
štampaj(d);

neka c = concentration(2, 5);
štampaj(c);
