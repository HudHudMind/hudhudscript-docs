// 日本語 - 関数
// 関数の定義と使用例

// 簡単な関数
関数 挨拶() {
    表示("こんにちは世界!");
}

// 引数付き関数
関数 足す(甲, 乙) {
    戻る 甲 + 乙;
}

// 複数引数の関数
関数 計算(数１, 数２, 操作) {
    もし (操作 == "足す") {
        戻る 数１ + 数２;
    } それでも {
        戻る 0;
    }
}

// 数学関数
関数 二乗(値) {
    戻る 値 * 値;
}

関数 三乗(値) {
    戻る 値 * 値 * 値;
}

// 関数の使用
挨拶();

変数 結果1 = 足す(5, 3);
表示(結果1);

変数 結果2 = 計算(10, 5, "足す");
表示(結果2);

変数 二乗の結果 = 二乗(4);
表示(二乗の結果);

変数 三乗の結果 = 三乗(3);
表示(三乗の結果);

// 関数の合成
変数 合計 = 足す(二乗(3), 三乗(2));
表示(合計);
