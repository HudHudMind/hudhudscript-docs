// 日本語 - 戻り値の概念
// return

関数 square(x) {
    返す x * x;
}

関数 cube(x) {
    返す x * x * x;
}

表示("=== Math Functions ===");
表示("square(5): " + square(5));
表示("cube(3): " + cube(3));

関数 絶対値(x) {
    もし (x < 0) {
        返す -x;
    }
    返す x;
}

表示("\n=== Absolute ===");
表示("絶対値(-7): " + 絶対値(-7));
表示("絶対値(3): " + 絶対値(3));

関数 点作成(x, y) {
    返す { x: x, y: y };
}

変数 p = 点作成(10, 20);
表示("\n=== Point ===");
表示("Point: (" + p.x + ", " + p.y + ")");

関数 階乗(n) {
    もし (n <= 1) {
        返す 1;
    }
    返す n * 階乗(n - 1);
}

表示("\n=== Factorial ===");
表示("5! = " + 階乗(5));
表示("10! = " + 階乗(10));
