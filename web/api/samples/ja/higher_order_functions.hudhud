// 日本語 - 高階関数
// 他の関数と連携する関数

// 関数を返す関数
関数 乗数器(係数) {
    返す (x) => x * 係数;
}

変数 二倍 = 乗数器(2);
変数 三倍 = 乗数器(3);

表示(二倍(5));  // 10
表示(三倍(5));  // 15

// 関数を受け取る関数
関数 適用(関数引数, 値) {
    返す 関数引数(値);
}

表示(適用(二倍, 10));  // 20

// 合成の例
関数 合成(f, g) {
    返す (x) => f(g(x));
}

変数 一を足す = (x) => x + 1;
変数 二を掛ける = (x) => x * 2;

変数 足して掛ける = 合成(二を掛ける, 一を足す);
表示(足して掛ける(5));  // 12 (5+1=6, 6*2=12)
