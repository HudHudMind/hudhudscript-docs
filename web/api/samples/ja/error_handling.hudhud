// Japanese - エラー処理
// if-elseによるエラー制御

関数 割り算(a, b) {
    もし (b == 0) {
        返す { エラー: 真, メッセージ: "ゼロ除算エラー", 値: 0 };
    }
    返す { エラー: 偽, メッセージ: "", 値: a / b };
}

表示("=== 除算処理 ===");

表示("10 / 2 の計算:");
変数 結果1 = 割り算(10, 2);
もし (結果1.エラー) {
    表示("エラー: " + 結果1.メッセージ);
} そうでないなら {
    表示("10 / 2 = " + 結果1.値);
}

表示("10 / 0 の計算:");
変数 結果2 = 割り算(10, 0);
もし (結果2.エラー) {
    表示("エラー検出: " + 結果2.メッセージ);
} そうでないなら {
    表示("結果: " + 結果2.値);
}

表示("完了");
