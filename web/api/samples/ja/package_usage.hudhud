// パッケージ使用法 - ハドハドスクリプト パッケージシステム
// パッケージ管理システム: 作成、インストール、公開、使用

// ============================================================
// 1. パッケージの使用
// ============================================================

// 外部パッケージの使用
使う "代数";
使う "物理";

// パッケージから特定モジュールをインポート
使う "代数/行列";
使う "代数/ベクトル";
使う "物理/運動";

表示("============================================================");
表示("ハドハドスクリプト パッケージシステムのデモ");
表示("============================================================\n");

// ============================================================
// 2. パッケージ関数の使用
// ============================================================

表示("代数パッケージの使用:");
表示("─────────────────────────────────────────────────────────\n");

// 行列の作成
変数 行列1 = 行列([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

変数 行列2 = 行列([
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]);

表示("行列 1:");
行列1.表示する();

表示("\n行列 2:");
行列2.表示する();

// 行列の加算
変数 合計 = 行列1.足す(行列2);
表示("\n行列の加算:");
合計.表示する();

// ベクトル演算
変数 ベクトル1 = ベクトル([1, 2, 3]);
変数 ベクトル2 = ベクトル([4, 5, 6]);

表示("\n\nベクトル演算:");
表示("─────────────────────────────────────────────────────────\n");

表示("ベクトル 1: " + ベクトル1.文字列());
表示("ベクトル 2: " + ベクトル2.文字列());

変数 内積 = ベクトル1.内積(ベクトル2);
表示("内積: " + 内積);

変数 外積 = ベクトル1.外積(ベクトル2);
表示("外積: " + 外積.文字列());

// ============================================================
// 3. 物理パッケージの使用
// ============================================================

表示("\n\n物理パッケージの使用:");
表示("─────────────────────────────────────────────────────────\n");

// 運動計算
変数 初速度 = 0;        // メートル毎秒
変数 加速度 = 9.8;      // メートル毎秒二乗 (重力)
変数 時間 = 5;           // 秒

変数 終速度 = 運動.速度計算(初速度, 加速度, 時間);
変数 距離 = 運動.距離計算(初速度, 加速度, 時間);

表示("初速度: " + 初速度 + " メートル毎秒");
表示("加速度: " + 加速度 + " メートル毎秒二乗");
表示("時間: " + 時間 + " 秒");
表示("─────────────────────────────────────────────────────────");
表示("終速度: " + 終速度 + " メートル毎秒");
表示("移動距離: " + 距離 + " メートル");

// ============================================================
// 4. パッケージの作成
// ============================================================

表示("\n\nパッケージの作成:");
表示("─────────────────────────────────────────────────────────\n");

表示("1. hudhud.toml ファイルを作成:");
表示("   [パッケージ]");
表示("   名前 = '数学ユーティリティ'");
表示("   バージョン = '1.0.0'");
表示("   説明 = '数学ヘルパー関数'");

表示("\n2. 依存関係を追加:");
表示("   [依存関係]");
表示("   代数 = '^2.0.0'");
表示("   物理 = '^1.5.0'");

// ============================================================
// 5. パッケージ管理コマンド
// ============================================================

表示("\n\nパッケージ管理コマンド:");
表示("─────────────────────────────────────────────────────────\n");

表示("パッケージのインストール:");
表示("  hudhudscript install 代数");
表示("  hudhudscript install 物理@1.5.0");

表示("\nパッケージの更新:");
表示("  hudhudscript update 代数");
表示("  hudhudscript update --all");

表示("\nパッケージの削除:");
表示("  hudhudscript remove 代数");

表示("\nインストール済みパッケージの一覧:");
表示("  hudhudscript list");

表示("\nパッケージの検索:");
表示("  hudhudscript search 数学");

表示("\nパッケージ情報:");
表示("  hudhudscript info 代数");

// ============================================================
// 6. パッケージの依存関係
// ============================================================

表示("\n\nパッケージの依存関係:");
表示("─────────────────────────────────────────────────────────\n");

表示("バージョン指定:");
表示("  '代数' = '^2.0.0'    # 2.x.x");
表示("  '物理' = '~1.5.0'    # 1.5.x");
表示("  '化学' = '1.2.3'     # 正確なバージョン");

表示("\nGitリポジトリから:");
表示("  'マイライブラリ' = { git = 'https://github.com/user/my-lib' }");

表示("\nローカルパスから:");
表示("  'ローカルライブラリ' = { path = '../ローカルライブラリ' }");

// ============================================================
// 7. パッケージのセキュリティ
// ============================================================

表示("\n\nパッケージのセキュリティ:");
表示("─────────────────────────────────────────────────────────\n");

表示("セキュリティ監査:");
表示("  hudhudscript audit");

表示("\nチェックサム検証:");
表示("  hudhudscript verify 代数");

表示("\n============================================================");
表示("パッケージシステムのデモが完了しました!");
表示("ハドハドスクリプトでモジュール化された再利用可能なコードを書きましょう");
表示("============================================================");
