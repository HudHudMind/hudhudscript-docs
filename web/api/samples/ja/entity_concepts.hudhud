// 日本語 - エンティティ概念

変数 利用者 = {
    識別子: 1,
    名前: "花子",
    メール: "hanako@example.com",
    役割: "開発者"
};

変数 製品 = {
    識別子: 101,
    名前: "ハドハドスクリプト開発環境",
    バージョン: "2.0",
    価格: 49
};

変数 注文 = {
    識別子: 1001,
    利用者識別子: 1,
    製品識別子: 101,
    数量: 2,
    状態: "確認済み"
};

関数 エンティティ情報(エンティティ) {
    返す "エンティティ #" + エンティティ.識別子 + ": " + エンティティ.名前;
}

関数 合計計算(注文, 価格) {
    返す 注文.数量 * 価格;
}

表示("=== エンティティシステム ===");
表示(エンティティ情報(利用者));
表示(エンティティ情報(製品));
変数 合計 = 合計計算(注文, 製品.価格);
表示("注文 #" + 注文.識別子 + " 合計: " + 合計);
表示("状態: " + 注文.状態);
