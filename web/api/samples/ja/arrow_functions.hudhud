// 日本語 - アロー関数
// 関数の簡潔な構文

// アロー関数 - 短い構文
変数 足す = (a, b) => a + b;
変数 掛ける = (x, y) => x * y;

表示(足す(5, 3));      // 8
表示(掛ける(4, 7)); // 28

// ブロック付きアロー関数
変数 計算する = (a, b) => {
    変数 合計 = a + b;
    変数 積 = a * b;
    返す 合計 + 積;
};

変数 結果 = 計算する(5, 3);
表示(結果);  // 23 (8 + 15)

// 単一パラメータ（括弧不要）
変数 二乗 = x => x * x;
表示(二乗(6));  // 36

// パラメータなし
変数 挨拶 = () => "こんにちは！";
表示(挨拶());  // こんにちは！
