// Polski - providers.hudhud

dostawca DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    nazwa: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    temperatura: 0.8
}

dostawca AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    nazwa: "Anthropic Claude",
    model: "claude-opus-4.6",
    temperatura: 0.9
}

dostawca OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    nazwa: "OpenAI GPT",
    temperatura: 0.6
}
