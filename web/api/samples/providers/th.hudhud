// ภาษาไทย - providers.hudhud

ผู้ให้บริการ DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    ชื่อ: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    อุณหภูมิ: 0.8
}

ผู้ให้บริการ AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    ชื่อ: "Anthropic Claude",
    model: "claude-opus-4.6",
    อุณหภูมิ: 0.9
}

ผู้ให้บริการ OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    ชื่อ: "OpenAI GPT",
    อุณหภูมิ: 0.6
}
