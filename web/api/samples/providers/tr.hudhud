// Türkçe - providers.hudhud

sağlayıcı DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    isim: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    sıcaklık: 0.8
}

sağlayıcı AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    isim: "Anthropic Claude",
    model: "claude-opus-4.6",
    sıcaklık: 0.9
}

sağlayıcı OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    isim: "OpenAI GPT",
    sıcaklık: 0.6
}
