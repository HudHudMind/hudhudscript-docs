// Indonesia - providers.hudhud

penyedia DeepSeekProvider {
    apiKey: env("DEEPSEEK_API_KEY"),
    type: "deepseek",
    nama: "DeepSeek API",
    baseUrl: env("DEEPSEEK_BASE_URL"),
    suhu: 0.8
}

penyedia AnthropicProvider {
    apiKey: env("ANTHROPIC_API_KEY"),
    type: "anthropic",
    nama: "Anthropic Claude",
    model: "claude-opus-4.6",
    suhu: 0.9
}

penyedia OpenAIProvider {
    apiKey: env("OPENAI_API_KEY"),
    type: "openai",
    nama: "OpenAI GPT",
    suhu: 0.6
}
