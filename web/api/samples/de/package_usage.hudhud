// Package Kullanımı - HudHudScript Paket Sistemi
// Paket yönetim sistemi: oluşturma, kurma, yayınlama ve kullanma

// ============================================================
// 1. PAKET KULLANIMI (Using Packages)
// ============================================================

// Harici paket kullanımı
verwenden "cebir";
verwenden "fizik" als paket;

// Paket içinden belirli modülleri içe aktarma
verwenden "cebir/matris";
verwenden "cebir/vektor";
verwenden "fizik/hareket";

schreibe("============================================================");
schreibe("HudHudScript Paket Sistemi Demo");
schreibe("============================================================\n");

// ============================================================
// 2. PAKET FONKSİYONLARINI KULLANMA
// ============================================================

schreibe("📦 Cebir Paketi Kullanımı:");
schreibe("─────────────────────────────────────────────────────────\n");

// Matris oluşturma
variable matris1 = Matris([
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 9]
]);

variable matris2 = Matris([
    [9, 8, 7],
    [6, 5, 4],
    [3, 2, 1]
]);

schreibe("Matris 1:");
matris1.goster();

schreibe("\nMatris 2:");
matris2.goster();

// Matris toplama
variable toplam = matris1.topla(matris2);
schreibe("\nMatris Toplama:");
toplam.goster();

// Vektör işlemleri
variable vektor1 = Vektor([1, 2, 3]);
variable vektor2 = Vektor([4, 5, 6]);

schreibe("\n\n📐 Vektör İşlemleri:");
schreibe("─────────────────────────────────────────────────────────\n");

schreibe("Vektör 1: " + vektor1.toString());
schreibe("Vektör 2: " + vektor2.toString());

variable noktaSal = vektor1.noktaSal(vektor2);
schreibe("Nokta Çarpım: " + noktaSal);

variable caprazCarpim = vektor1.caprazCarpim(vektor2);
schreibe("Çapraz Çarpım: " + caprazCarpim.toString());

// ============================================================
// 3. FİZİK PAKETİ KULLANIMI
// ============================================================

schreibe("\n\n⚡ Fizik Paketi Kullanımı:");
schreibe("─────────────────────────────────────────────────────────\n");

// Hareket hesaplamaları
variable baslangicHizi = 0;      // m/s
variable ivme = 9.8;              // m/s² (yerçekimi)
variable zaman = 5;               // saniye

variable sonHiz = Hareket.hizHesapla(baslangicHizi, ivme, zaman);
variable mesafe = Hareket.mesafeHesapla(baslangicHizi, ivme, zaman);

schreibe("Başlangıç Hızı: " + baslangicHizi + " m/s");
schreibe("İvme: " + ivme + " m/s²");
schreibe("Zaman: " + zaman + " s");
schreibe("─────────────────────────────────────────────────────────");
schreibe("Son Hız: " + sonHiz + " m/s");
schreibe("Alınan Mesafe: " + mesafe + " m");

// ============================================================
// 4. PAKET OLUŞTURMA (Package Creation)
// ============================================================

schreibe("\n\n📝 Paket Oluşturma:");
schreibe("─────────────────────────────────────────────────────────\n");

schreibe("1. hudhud.toml dosyası oluşturun:");
schreibe("   [package]");
schreibe("   name = 'matematik-utils'");
schreibe("   version = '1.0.0'");
schreibe("   description = 'Matematik yardımcı fonksiyonları'");

schreibe("\n2. Bağımlılıklar ekleyin:");
schreibe("   [dependencies]");
schreibe("   cebir = '^2.0.0'");
schreibe("   fizik = '^1.5.0'");

// ============================================================
// 5. PAKET YÖNETİMİ KOMUTLARI
// ============================================================

schreibe("\n\n🔧 Paket Yönetimi Komutları:");
schreibe("─────────────────────────────────────────────────────────\n");

schreibe("Paket kurma:");
schreibe("  hudhudscript install cebir");
schreibe("  hudhudscript install fizik@1.5.0");

schreibe("\nPaket güncelleme:");
schreibe("  hudhudscript update cebir");
schreibe("  hudhudscript update --all");

schreibe("\nPaket kaldırma:");
schreibe("  hudhudscript remove cebir");

schreibe("\nKurulu paketleri listeleme:");
schreibe("  hudhudscript list");

schreibe("\nPaket arama:");
schreibe("  hudhudscript search matematik");

schreibe("\nPaket bilgisi:");
schreibe("  hudhudscript info cebir");

// ============================================================
// 6. PAKET BAĞIMLILIKLARI
// ============================================================

schreibe("\n\n🔗 Paket Bağımlılıkları:");
schreibe("─────────────────────────────────────────────────────────\n");

schreibe("Versiyon belirtme:");
schreibe("  'cebir' = '^2.0.0'    # 2.x.x");
schreibe("  'fizik' = '~1.5.0'    # 1.5.x");
schreibe("  'kimya' = '1.2.3'     # Tam versiyon");

schreibe("\nGit deposundan:");
schreibe("  'my-lib' = { git = 'https://github.com/user/my-lib' }");

schreibe("\nYerel yoldan:");
schreibe("  'local-lib' = { path = '../local-lib' }");

// ============================================================
// 7. PAKET GÜVENLİĞİ
// ============================================================

schreibe("\n\n🔒 Paket Güvenliği:");
schreibe("─────────────────────────────────────────────────────────\n");

schreibe("Güvenlik kontrolü:");
schreibe("  hudhudscript audit");

schreibe("\nChecksum doğrulama:");
schreibe("  hudhudscript verify cebir");

schreibe("\n============================================================");
schreibe("✓ Paket sistemi demo tamamlandı!");
schreibe("✓ HudHudScript ile modüler ve yeniden kullanılabilir kod yazın");
schreibe("============================================================");
