// Ελληνικά - Demo
συνάρτηση χαιρέτισε(όνομα) {
    επιστροφή "Γεια, " + όνομα + "!";
}

συνάρτηση πρόσθεσε(α, β) {
    επιστροφή α + β;
}

ας μήνυμα = χαιρέτισε("Κόσμε");
εκτύπωσε(μήνυμα);

ας σύνολο = 0;
ας μετρητής = 1;
ενώ (μετρητής <= 10) {
    σύνολο = πρόσθεσε(σύνολο, μετρητής);
    μετρητής = μετρητής + 1;
}
εκτύπωσε("Σύνολο 1-10: " + σύνολο);
