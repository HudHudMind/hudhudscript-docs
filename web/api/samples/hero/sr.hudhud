// Српски - Demo
функција поздрави(име) {
    врати "Здраво, " + име + "!";
}

функција сабери(а, б) {
    врати а + б;
}

нека порука = поздрави("Свет");
испис(порука);

нека збир = 0;
нека бројач = 1;
док (бројач <= 10) {
    збир = сабери(збир, бројач);
    бројач = бројач + 1;
}
испис("Збир 1-10: " + збир);
