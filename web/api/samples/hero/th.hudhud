// ภาษาไทย - Demo
ฟังก์ชัน ทักทาย(ชื่อ) {
    คืนค่า "สวัสดี, " + ชื่อ + "!";
}

ฟังก์ชัน บวก(ก, ข) {
    คืนค่า ก + ข;
}

ให้ ข้อความ = ทักทาย("โลก");
พิมพ์(ข้อความ);

ให้ ผลรวม = 0;
ให้ ตัวนับ = 1;
ขณะที่ (ตัวนับ <= 10) {
    ผลรวม = บวก(ผลรวม, ตัวนับ);
    ตัวนับ = ตัวนับ + 1;
}
พิมพ์("ผลรวม 1-10: " + ผลรวม);
