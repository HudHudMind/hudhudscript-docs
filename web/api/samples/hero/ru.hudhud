// Русский - Demo
функция приветствовать(имя) {
    вернуть "Привет, " + имя + "!";
}

функция сложить(а, б) {
    вернуть а + б;
}

переменная сообщение = приветствовать("Мир");
печать(сообщение);

переменная сумма = 0;
переменная счётчик = 1;
пока (счётчик <= 10) {
    сумма = сложить(сумма, счётчик);
    счётчик = счётчик + 1;
}
печать("Сумма 1-10: " + сумма);
