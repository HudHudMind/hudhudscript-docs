// فارسی - Demo
تابع سلام(نام) {
    برگردان "سلام، " + نام + "!";
}

تابع جمع(الف, ب) {
    برگردان الف + ب;
}

متغیر پیام = سلام("دنیا");
چاپ(پیام);

متغیر مجموع = 0;
متغیر شمارنده = 1;
تا_وقتی (شمارنده <= 10) {
    مجموع = جمع(مجموع, شمارنده);
    شمارنده = شمارنده + 1;
}
چاپ("مجموع 1-10: " + مجموع);
