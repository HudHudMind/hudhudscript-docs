// हिन्दी - इकाई अवधारणाएँ

मान उपयोगकर्ता = {
    आईडी: १,
    नाम: "आशा",
    ईमेल: "asha@udaharan.com",
    भूमिका: "डेवलपर"
};

मान उत्पाद = {
    आईडी: १०१,
    नाम: "हुदहुदस्क्रिप्ट आईडीई",
    संस्करण: "२.०",
    मूल्य: ४९
};

मान आदेश = {
    आईडी: १००१,
    उपयोगकर्ता_आईडी: १,
    उत्पाद_आईडी: १०१,
    मात्रा: २,
    स्थिति: "पुष्ट"
};

फ़ंक्शन इकाई_जानकारी(इकाई) {
    वापस "इकाई #" + इकाई.आईडी + ": " + इकाई.नाम;
}

फ़ंक्शन कुल_गणना(आदेश, मूल्य) {
    वापस आदेश.मात्रा * मूल्य;
}

प्रिंट("=== इकाई प्रणाली ===");
प्रिंट(इकाई_जानकारी(उपयोगकर्ता));
प्रिंट(इकाई_जानकारी(उत्पाद));
मान कुल = कुल_गणना(आदेश, उत्पाद.मूल्य);
प्रिंट("आदेश #" + आदेश.आईडी + " कुल: " + कुल);
प्रिंट("स्थिति: " + आदेश.स्थिति);
