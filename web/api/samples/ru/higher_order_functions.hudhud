// Русский - Функции высшего порядка
// Функции, работающие с другими функциями

// Функция, возвращающая функцию
функция множитель(коэффициент) {
    вернуть (х) => х * коэффициент;
}

пусть удвоить = множитель(2);
пусть утроить = множитель(3);

печать(удвоить(5));  // 10
печать(утроить(5));  // 15

// Функция, принимающая функцию
функция применить(функ, значение) {
    вернуть функ(значение);
}

печать(применить(удвоить, 10));  // 20

// Пример композиции
функция составить(ф, г) {
    вернуть (х) => ф(г(х));
}

пусть добавитьОдин = (х) => х + 1;
пусть умножитьНаДва = (х) => х * 2;

пусть сложитьЗатемУдвоить = составить(умножитьНаДва, добавитьОдин);
печать(сложитьЗатемУдвоить(5));  // 12 (5+1=6, 6*2=12)
