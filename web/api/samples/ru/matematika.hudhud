// Русский - Math Module

функция сложить(a, b) {
    вернуть a + b;
}

функция вычесть(a, b) {
    вернуть a - b;
}

функция умножить(a, b) {
    вернуть a * b;
}

функция разделить(a, b) {
    если (b == 0) {
        печать("Error: Division by zero!");
        вернуть 0;
    } иначе {
        вернуть a / b;
    }
}

функция квадрат(x) {
    вернуть x * x;
}

функция куб(x) {
    вернуть x * x * x;
}

функция модуль(x) {
    если (x < 0) {
        вернуть -x;
    } иначе {
        вернуть x;
    }
}

функция максимум(a, b) {
    если (a > b) {
        вернуть a;
    } иначе {
        вернуть b;
    }
}

функция минимум(a, b) {
    если (a < b) {
        вернуть a;
    } иначе {
        вернуть b;
    }
}
