// Русский - Функция приветствия

функция приветствуй(имя) {
    пусть сообщение = "Привет, " + имя + "!";
    печать(сообщение);
    вернуть сообщение;
}

функция сложи(а, б) {
    вернуть а + б;
}

пусть результат = приветствуй("Мир");
печать(результат);

пусть сумма = сложи(42, 58);
печать("сумма: " + сумма);
