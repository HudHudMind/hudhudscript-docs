// Ελληνικά - Συνάρτηση χαιρετισμού

συνάρτηση χαιρέτησε(όνομα) {
    μεταβλητή μήνυμα = "Γεια, " + όνομα + "!";
    εκτύπωσε(μήνυμα);
    επιστροφή μήνυμα;
}

συνάρτηση πρόσθεσε(α, β) {
    επιστροφή α + β;
}

μεταβλητή αποτέλεσμα = χαιρέτησε("Κόσμε");
εκτύπωσε(αποτέλεσμα);

μεταβλητή άθροισμα = πρόσθεσε(42, 58);
εκτύπωσε("άθροισμα: " + άθροισμα);
