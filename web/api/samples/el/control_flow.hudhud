// Ελληνικά - Έλεγχος Ροής
μεταβλητή μετρητής = 0;
μεταβλητή μέγιστο = 5;

// Loop
ενώ (μετρητής < μέγιστο) {
    μετρητής = μετρητής + 1;
}

// Conditional
μεταβλητή βαθμολογία = 85;

αν (βαθμολογία >= 90) {
    βαθμολογία;
} αλλιώς {
    αν (βαθμολογία >= 80) {
        βαθμολογία;
    } αλλιώς {
        βαθμολογία;
    }
}

μετρητής;