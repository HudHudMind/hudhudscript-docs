// Ελληνικά - Έννοιες Switch/Case
// switch/case/default

συνάρτηση τύπος_ημέρας(day) {
    επίλεξε (day) {
        περίπτωση "Monday":
        περίπτωση "Tuesday":
        περίπτωση "Wednesday":
        περίπτωση "Thursday":
        περίπτωση "Friday":
            επέστρεψε "Εργάσιμη";
        περίπτωση "Saturday":
        περίπτωση "Sunday":
            επέστρεψε "Σαββατοκύριακο";
        προεπιλογή:
            επέστρεψε "Άγνωστο";
    }
}

εκτύπωσε("=== Day Types ===");
εκτύπωσε("Monday: " + τύπος_ημέρας("Monday"));
εκτύπωσε("Saturday: " + τύπος_ημέρας("Saturday"));
εκτύπωσε("Holiday: " + τύπος_ημέρας("Holiday"));

συνάρτηση βαθμός_γράμμα(score) {
    επίλεξε (score) {
        περίπτωση 90:
            επέστρεψε "A";
        περίπτωση 80:
            επέστρεψε "B";
        περίπτωση 70:
            επέστρεψε "C";
        περίπτωση 60:
            επέστρεψε "D";
        προεπιλογή:
            επέστρεψε "F";
    }
}

εκτύπωσε("\n=== Grades ===");
εκτύπωσε("90: " + βαθμός_γράμμα(90));
εκτύπωσε("70: " + βαθμός_γράμμα(70));
εκτύπωσε("50: " + βαθμός_γράμμα(50));

συνάρτηση μήνυμα_κατάστασης(code) {
    επίλεξε (code) {
        περίπτωση 200:
            επέστρεψε "OK";
        περίπτωση 404:
            επέστρεψε "Not Found";
        περίπτωση 500:
            επέστρεψε "Server Error";
        προεπιλογή:
            επέστρεψε "Άγνωστο Status";
    }
}

εκτύπωσε("\n=== HTTP Status ===");
εκτύπωσε("200: " + μήνυμα_κατάστασης(200));
εκτύπωσε("404: " + μήνυμα_κατάστασης(404));
