// Español - Modules & Code Organization
// Demonstrates module system: usar/importar like Rust, Java, C++, Python

// Import math module
usar "math.hudhud";

// Example syntax variations:
// usar "math.hudhud";
// usar { add, subtract } desde "math.hudhud";
// usar "math.hudhud" como math;

// Using functions desde math module
sea sum = add(10, 5);
imprimir(sum);

sea diff = subtract(20, 8);
imprimir(diff);

sea product = multiply(4, 7);
imprimir(product);

sea quotient = divide(15, 3);
imprimir(quotient);

sea squared = square(5);
imprimir(squared);

sea cubed = cube(3);
imprimir(cubed);

sea absolute = abs(-42);
imprimir(absolute);

sea maximum = max(100, 50);
imprimir(maximum);

sea minimum = min(100, 50);
imprimir(minimum);

// Complex calculation using multiple functions
sea result = add(multiply(5, 3), divide(20, 4));
imprimir(result);
