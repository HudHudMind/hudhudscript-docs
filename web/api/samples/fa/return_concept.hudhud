// فارسی - مفهوم بازگشت
// return

تابع مربع(x) {
    برگردان x * x;
}

تابع مکعب(x) {
    برگردان x * x * x;
}

چاپ("=== Math Functions ===");
چاپ("مربع(5): " + مربع(5));
چاپ("مکعب(3): " + مکعب(3));

تابع قدرمطلق(x) {
    اگر (x < 0) {
        برگردان -x;
    }
    برگردان x;
}

چاپ("\n=== Absolute ===");
چاپ("قدرمطلق(-7): " + قدرمطلق(-7));
چاپ("قدرمطلق(3): " + قدرمطلق(3));

تابع ایجاد_نقطه(x, y) {
    برگردان { x: x, y: y };
}

بگذار p = ایجاد_نقطه(10, 20);
چاپ("\n=== Point ===");
چاپ("Point: (" + p.x + ", " + p.y + ")");

تابع فاکتوریل(n) {
    اگر (n <= 1) {
        برگردان 1;
    }
    برگردان n * فاکتوریل(n - 1);
}

چاپ("\n=== Factorial ===");
چاپ("5! = " + فاکتوریل(5));
چاپ("10! = " + فاکتوریل(10));
