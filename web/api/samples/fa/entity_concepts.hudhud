// فارسی - مفاهیم موجودیت

بگذار کاربر = {
    شناسه: ۱,
    نام: "فاطمه",
    ایمیل: "fatemeh@namune.com",
    نقش: "برنامه‌نویس"
};

بگذار محصول = {
    شناسه: ۱۰۱,
    نام: "هدهد اسکریپت آی‌دی‌ای",
    نسخه: "۲.۰",
    قیمت: ۴۹
};

بگذار سفارش = {
    شناسه: ۱۰۰۱,
    شناسه_کاربر: ۱,
    شناسه_محصول: ۱۰۱,
    تعداد: ۲,
    وضعیت: "تایید شده"
};

تابع اطلاعات_موجودیت(موجودیت) {
    برگردان "موجودیت #" + موجودیت.شناسه + ": " + موجودیت.نام;
}

تابع محاسبه_کل(سفارش, قیمت) {
    برگردان سفارش.تعداد * قیمت;
}

چاپ("=== سیستم موجودیت ===");
چاپ(اطلاعات_موجودیت(کاربر));
چاپ(اطلاعات_موجودیت(محصول));
بگذار کل = محاسبه_کل(سفارش, محصول.قیمت);
چاپ("سفارش #" + سفارش.شناسه + " کل: " + کل);
چاپ("وضعیت: " + سفارش.وضعیت);
