// 中文 - 实体概念

变量 用户 = {
    标识: 1,
    名称: "小红",
    邮箱: "xiaohong@example.com",
    角色: "开发者"
};

变量 产品 = {
    标识: 101,
    名称: "哈德哈德脚本开发环境",
    版本: "2.0",
    价格: 49
};

变量 订单 = {
    标识: 1001,
    用户标识: 1,
    产品标识: 101,
    数量: 2,
    状态: "已确认"
};

函数 实体信息(实体) {
    返回 "实体 #" + 实体.标识 + ": " + 实体.名称;
}

函数 计算总额(订单, 价格) {
    返回 订单.数量 * 价格;
}

打印("=== 实体系统 ===");
打印(实体信息(用户));
打印(实体信息(产品));
变量 总额 = 计算总额(订单, 产品.价格);
打印("订单 #" + 订单.标识 + " 总额: " + 总额);
打印("状态: " + 订单.状态);
