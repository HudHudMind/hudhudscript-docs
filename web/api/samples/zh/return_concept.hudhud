// 中文 - 返回值概念
// return

函数 平方(x) {
    返回 x * x;
}

函数 立方(x) {
    返回 x * x * x;
}

打印("=== Math Functions ===");
打印("平方(5): " + 平方(5));
打印("立方(3): " + 立方(3));

函数 绝对值(x) {
    如果 (x < 0) {
        返回 -x;
    }
    返回 x;
}

打印("\n=== Absolute ===");
打印("绝对值(-7): " + 绝对值(-7));
打印("绝对值(3): " + 绝对值(3));

函数 创建点(x, y) {
    返回 { x: x, y: y };
}

变量 p = 创建点(10, 20);
打印("\n=== Point ===");
打印("Point: (" + p.x + ", " + p.y + ")");

函数 阶乘(n) {
    如果 (n <= 1) {
        返回 1;
    }
    返回 n * 阶乘(n - 1);
}

打印("\n=== Factorial ===");
打印("5! = " + 阶乘(5));
打印("10! = " + 阶乘(10));
