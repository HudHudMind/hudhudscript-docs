// 中文 - 客户服务代理

法律 尊重法则 {
    描述: "代理必须礼貌和尊重客户",
    优先级: 1
}

宪法 服务宪法 {
    法律列表: [尊重法则],
    描述: "客户服务框架"
}

代理 服务代理 {
    模型: "gpt-4"
}

函数 欢迎(客户名) {
    变量 消息 = "您好 " + 客户名 + "，请问有什么可以帮您？";
    打印(消息);
    返回 消息;
}

函数 处理请求(类型, 详情) {
    如果 (类型 == "投诉") {
        打印("非常抱歉给您带来不便。我会帮您解决问题。");
    } 否则 {
        打印("感谢您的联系。我现在为您处理请求。");
    }
    返回 "已处理: " + 类型 + " - " + 详情;
}

打印("=== 客户服务代理 ===");
欢迎("小明");
变量 结果 = 处理请求("投诉", "快递延迟");
打印(结果);
