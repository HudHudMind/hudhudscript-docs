// 中文 - 箭头函数
// 函数的简洁语法

// 箭头函数 - 简短语法
变量 加法 = (a, b) => a + b;
变量 乘法 = (x, y) => x * y;

打印(加法(5, 3));      // 8
打印(乘法(4, 7)); // 28

// 带代码块的箭头函数
变量 计算 = (a, b) => {
    变量 总和 = a + b;
    变量 乘积 = a * b;
    返回 总和 + 乘积;
};

变量 结果 = 计算(5, 3);
打印(结果);  // 23 (8 + 15)

// 单参数（不需要括号）
变量 平方 = x => x * x;
打印(平方(6));  // 36

// 无参数
变量 问候 = () => "你好！";
打印(问候());  // 你好！
