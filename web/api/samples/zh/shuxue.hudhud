// 中文 - Math Module

函数 加(a, b) {
    返回 a + b;
}

函数 减(a, b) {
    返回 a - b;
}

函数 乘(a, b) {
    返回 a * b;
}

函数 除(a, b) {
    如果 (b == 0) {
        打印("Error: Division by zero!");
        返回 0;
    } 否则 {
        返回 a / b;
    }
}

函数 平方(x) {
    返回 x * x;
}

函数 立方(x) {
    返回 x * x * x;
}

函数 绝对值(x) {
    如果 (x < 0) {
        返回 -x;
    } 否则 {
        返回 x;
    }
}

函数 最大(a, b) {
    如果 (a > b) {
        返回 a;
    } 否则 {
        返回 b;
    }
}

函数 最小(a, b) {
    如果 (a < b) {
        返回 a;
    } 否则 {
        返回 b;
    }
}
