// SR - Math Module

на add(a, b) {
    врати a + b;
}

на subtract(a, b) {
    врати a - b;
}

на multiply(a, b) {
    врати a * b;
}

на divide(a, b) {
    ако (b == 0) {
        штампај("Error: Division by zero!");
        врати 0;
    } иначе {
        врати a / b;
    }
}

на square(x) {
    врати x * x;
}

на cube(x) {
    врати x * x * x;
}

на abs(x) {
    ако (x < 0) {
        врати -x;
    } иначе {
        врати x;
    }
}

на max(a, b) {
    ако (a > b) {
        врати a;
    } иначе {
        врати b;
    }
}

на min(a, b) {
    ако (a < b) {
        врати a;
    } иначе {
        врати b;
    }
}
