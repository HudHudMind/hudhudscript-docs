// Српски - Контрола Тока
променљива бројач = 0;
променљива максимум = 5;

// Loop
док (бројач < максимум) {
    бројач = бројач + 1;
}

// Conditional
променљива резултат = 85;

ако (резултат >= 90) {
    резултат;
} иначе {
    ако (резултат >= 80) {
        резултат;
    } иначе {
        резултат;
    }
}

бројач;